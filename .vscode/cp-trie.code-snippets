    "body": [
      "#include<string>",
      "#include<vector>",
      "",
      "class Trie {",
      "private:",
      "    struct TrieNode {",
      "        TrieNode* children[26] = {};  // 0-indexed child pointers for characters 'a' through 'z' (c - 'a')",
      "        bool is_terminal = false;     // True if a complete word terminates at this node",
      "        int prefix_count = 0;         // Number of words sharing the prefix up to this node",
      "    };",
      "    TrieNode* root;",
      "",
      "public:",
      "    // Initializes empty Trie with root node",
      "    Trie() : root(new TrieNode()) {}",
      "",
      "    // Inserts word into trie; O(|word|)",
      "    void insert(const std::string& word) {",
      "        TrieNode* cur = root;",
      "        for (char c : word) {",
      "            int idx = c - 'a';  // 0-indexed alphabet index (0 to 25)",
      "            if (!cur->children[idx]) {",
      "                cur->children[idx] = new TrieNode();",
      "            }",
      "            cur = cur->children[idx];",
      "            cur->prefix_count++;",
      "        }",
      "        cur->is_terminal = true;",
      "    }",
      "",
      "    // Searches if word exists in trie; returns true if found; O(|word|)",
      "    bool search(const std::string& word) const {",
      "        TrieNode* cur = root;",
      "        for (char c : word) {",
      "            int idx = c - 'a';  // 0-indexed alphabet index",
      "            if (!cur->children[idx]) return false;",
      "            cur = cur->children[idx];",
      "        }",
      "        return cur->is_terminal;",
      "    }",
      "",
      "    // Checks if any word starts with prefix; returns true if prefix exists; O(|prefix|)",
      "    bool startsWith(const std::string& prefix) const {",
      "        TrieNode* cur = root;",
      "        for (char c : prefix) {",
      "            int idx = c - 'a';  // 0-indexed alphabet index",
      "            if (!cur->children[idx]) return false;",
      "            cur = cur->children[idx];",
      "        }",
      "        return true;",
      "    }",
      "};"
    ],
    "description": "Standard 26-way prefix tree (Trie) for lowercase strings with 0-indexed alphabet characters."
  },
