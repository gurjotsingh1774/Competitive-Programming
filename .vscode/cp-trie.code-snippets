    "body": [
      "// BinaryTrie: multiset of non-negative integers < 2^B; max/min xor with a value. O(B) per op.",
      "template <int B = 30> struct BinaryTrie {",
      "    vector<array<int, 2>> ch;  // 0-indexed child pointers for bits 0 and 1 (-1 if null)",
      "    vector<int> cnt;           // Number of active integers in subtree",
      "",
      "    // Initializes binary trie with empty root node at 0-indexed index 0",
      "    BinaryTrie() { ch.push_back({-1, -1}); cnt.push_back(0); }",
      "",
      "    // Inserts integer x into trie with weight c (default +1 for insert, -1 for erase); O(B)",
      "    void insert(long long x, int c = 1) {",
      "        int u = 0;",
      "        for (int b = B - 1; b >= 0; b--) {  // 0-indexed bit from MSB (B-1) down to 0",
      "            int bit = (x >> b) & 1;",
      "            if (ch[u][bit] < 0) { ch[u][bit] = ch.size(); ch.push_back({-1, -1}); cnt.push_back(0); }",
      "            u = ch[u][bit];",
      "            cnt[u] += c;",
      "        }",
      "    }",
      "",
      "    // Erases one copy of integer x from trie (x must be present); O(B)",
      "    void erase(long long x) { insert(x, -1); }",
      "",
      "    // Computes max(x ^ y) over all y stored in trie (trie must be non-empty); O(B)",
      "    long long max_xor(long long x) const {",
      "        int u = 0;",
      "        long long res = 0;",
      "        for (int b = B - 1; b >= 0; b--) {",
      "            int bit = (x >> b) & 1, want = bit ^ 1;",
      "            if (ch[u][want] >= 0 && cnt[ch[u][want]] > 0) res |= 1LL << b, u = ch[u][want];",
      "            else u = ch[u][bit];",
      "        }",
      "        return res;",
      "    }",
      "",
      "    // Computes min(x ^ y) over all y stored in trie (trie must be non-empty); O(B)",
      "    long long min_xor(long long x) const {",
      "        int u = 0;",
      "        long long res = 0;",
      "        for (int b = B - 1; b >= 0; b--) {",
      "            int bit = (x >> b) & 1;",
      "            if (ch[u][bit] >= 0 && cnt[ch[u][bit]] > 0) u = ch[u][bit];",
      "            else res |= 1LL << b, u = ch[u][bit ^ 1];",
      "        }",
      "        return res;",
      "    }",
      "};"
    ],
    "description": "Binary Trie for maintaining a multiset of integers < 2^B with maximum/minimum XOR queries in O(B)."
  }
