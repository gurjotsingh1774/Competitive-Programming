  "Point Update Merge Sort Tree": {
    "prefix": [
      "cp-point-update-mst",
      "cp-pmst"
    ],
    "body": [
      "#include <ext/pb_ds/assoc_container.hpp>",
      "#include <ext/pb_ds/tree_policy.hpp>",
      "",
      "// Point-Update Merge Sort Tree via PBDS ordered_set of pair<T, int> for unique duplicate handling.",
      "// Supports point update in O(log^2 n), range order count queries in O(log^2 n), and range k-th query in O(log^3 n).",
      "// 0-indexed [l, r] inclusive.",
      "template <class T = long long>",
      "struct PointUpdateMergeSortTree {",
      "    using NodeKey = pair<T, int>;",
      "    using OrderedSet = __gnu_pbds::tree<NodeKey, __gnu_pbds::null_type, less<NodeKey>, __gnu_pbds::rb_tree_tag, __gnu_pbds::tree_order_statistics_node_update>;",
      "",
      "    int n;",
      "    vector<T> a;",
      "    vector<OrderedSet> t;",
      "",
      "    PointUpdateMergeSortTree(int n_ = 0) : n(n_), a(n_), t(4 * n_) {}",
      "    PointUpdateMergeSortTree(const vector<T> &init_a) : n((int)init_a.size()), a(init_a), t(4 * n) {",
      "        if (n > 0) build(1, 0, n - 1);",
      "    }",
      "",
      "    void build(int node, int start, int end) {",
      "        for (int i = start; i <= end; i++) {",
      "            t[node].insert({a[i], i});",
      "        }",
      "        if (start == end) return;",
      "        int mid = start + (end - start) / 2;",
      "        build(2 * node, start, mid);",
      "        build(2 * node + 1, mid + 1, end);",
      "    }",
      "",
      "    // Point update: a[idx] = val in O(log^2 n)",
      "    void point_update(int idx, T val) {",
      "        if (idx < 0 || idx >= n) return;",
      "        T old_val = a[idx];",
      "        a[idx] = val;",
      "        update_internal(1, 0, n - 1, idx, old_val, val);",
      "    }",
      "",
      "    // Generic query over range [l, r] (0-indexed inclusive). Sums pred(t[node]) across all canonical segments.",
      "    template <class F>",
      "    int query(int l, int r, F pred) const {",
      "        if (l > r || l < 0 || r >= n) return 0;",
      "        return query_internal(1, 0, n - 1, l, r, pred);",
      "    }",
      "",
      "    // Range k-th smallest element (1-indexed k) in O(log^3 n).",
      "    // Binary searches rank in [0, n-1] via root find_by_order, and counts <= candidate via segment order_of_key.",
      "    T kth(int l, int r, int k) const {",
      "        if (l > r || k <= 0 || k > r - l + 1 || n == 0) return T();",
      "        int low = 0, high = n - 1;",
      "        T ans = a[l];",
      "        while (low <= high) {",
      "            int mid = low + (high - low) / 2;",
      "            T val = t[1].find_by_order(mid)->first;",
      "            int cnt = query(l, r, [&](const auto &s) {",
      "                return (int)s.order_of_key({val, numeric_limits<int>::max()});",
      "            });",
      "            if (cnt >= k) {",
      "                ans = val;",
      "                high = mid - 1;",
      "            } else {",
      "                low = mid + 1;",
      "            }",
      "        }",
      "        return ans;",
      "    }",
      "",
      "private:",
      "    void update_internal(int node, int start, int end, int idx, const T &old_val, const T &new_val) {",
      "        t[node].erase({old_val, idx});",
      "        t[node].insert({new_val, idx});",
      "        if (start == end) return;",
      "        int mid = start + (end - start) / 2;",
      "        if (idx <= mid) update_internal(2 * node, start, mid, idx, old_val, new_val);",
      "        else update_internal(2 * node + 1, mid + 1, end, idx, old_val, new_val);",
      "    }",
      "",
      "    template <class F>",
      "    int query_internal(int node, int start, int end, int l, int r, F pred) const {",
      "        if (end < l || r < start) return 0;",
      "        if (l <= start && end <= r) return pred(t[node]);",
      "        int mid = start + (end - start) / 2;",
      "        return query_internal(2 * node, start, mid, l, r, pred) +",
      "               query_internal(2 * node + 1, mid + 1, end, l, r, pred);",
      "    }",
      "};"
    ],
    "description": "Point-Update Merge Sort Tree via PBDS ordered_set. O(log^2 n) update & order count, O(log^3 n) range kth element."
  },
