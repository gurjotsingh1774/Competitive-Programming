  "Merge Sort Tree": {
    "prefix": [
      "cp-merge-sort-tree",
      "cp-mst"
    ],
    "body": [
      "template <class T = int>",
      "struct MergeSortTree {",
      "    int n;",
      "    vector<vector<T>> tree;",
      "",
      "    MergeSortTree(int n_ = 0) : n(n_), tree(4 * n_) {}",
      "    MergeSortTree(const vector<T> &a) : n((int)a.size()), tree(4 * n) {",
      "        if (n > 0) build(1, 0, n - 1, a);",
      "    }",
      "",
      "    void build(int node, int start, int end, const vector<T> &a) {",
      "        if (start == end) {",
      "            tree[node] = {a[start]};",
      "            return;",
      "        }",
      "        int mid = start + (end - start) / 2;",
      "        build(2 * node, start, mid, a);",
      "        build(2 * node + 1, mid + 1, end, a);",
      "        tree[node].resize(tree[2 * node].size() + tree[2 * node + 1].size());",
      "        merge(tree[2 * node].begin(), tree[2 * node].end(),",
      "              tree[2 * node + 1].begin(), tree[2 * node + 1].end(),",
      "              tree[node].begin());",
      "    }",
      "",
      "    // Generic query over range [l, r] (0-indexed inclusive).",
      "    // Calls pred(tree[node]) on every canonical segment and sums the results.",
      "    template <class F>",
      "    int query(int l, int r, F pred) const {",
      "        if (l > r || l < 0 || r >= n) return 0;",
      "        return query_internal(1, 0, n - 1, l, r, pred);",
      "    }",
      "",
      "    // Range k-th smallest element (1-indexed k) in O(log^3 n).",
      "    T kth(int l, int r, int k) const {",
      "        if (l > r || k <= 0 || k > r - l + 1 || n == 0) return T();",
      "        int low = 0, high = n - 1;",
      "        T ans = tree[1][high];",
      "        while (low <= high) {",
      "            int mid = low + (high - low) / 2;",
      "            T val = tree[1][mid];",
      "            int cnt = query(l, r, [&](const auto &v) {",
      "                return (int)(upper_bound(v.begin(), v.end(), val) - v.begin());",
      "            });",
      "            if (cnt >= k) {",
      "                ans = val;",
      "                high = mid - 1;",
      "            } else {",
      "                low = mid + 1;",
      "            }",
      "        }",
      "        return ans;",
      "    }",
      "",
      "private:",
      "    template <class F>",
      "    int query_internal(int node, int start, int end, int l, int r, F pred) const {",
      "        if (end < l || r < start) return 0;",
      "        if (l <= start && end <= r) return pred(tree[node]);",
      "        int mid = start + (end - start) / 2;",
      "        return query_internal(2 * node, start, mid, l, r, pred) +",
      "               query_internal(2 * node + 1, mid + 1, end, l, r, pred);",
      "    }",
      "};"
    ],
    "description": "Merge Sort Tree (0-indexed [l, r] inclusive) with generic canonical-segment query in O(log^2 n)."
  },
