    ],
    "body": [
      "// Range x -> a*x + b, range sum mod 998244353  (keep a, b and initial values in [0, MOD))",
      "namespace RangeAffineSum {",
      "    const long long MOD = 998244353;",
      "    struct Node { long long sum; int len; };",
      "    struct Tag { long long mul, add; };",
      "    Node combine(Node l, Node r) { return {(l.sum + r.sum) % MOD, l.len + r.len}; }",
      "    Node node_id() { return {0, 0}; }",
      "    Node apply_tag(Tag f, Node x) { return {(f.mul * x.sum + f.add * x.len) % MOD, x.len}; }",
      "    Tag compose_tag(Tag f, Tag g) { return {(f.mul * g.mul) % MOD, (f.mul * g.add + f.add) % MOD}; }",
      "    Tag tag_id() { return {1, 0}; }",
      "    using Tree = LazySegTree<Node, combine, node_id, Tag, apply_tag, compose_tag, tag_id>;",
      "    Tree make(const vector<long long> &a) {",
      "        vector<Node> v(a.size());",
      "        for (size_t i = 0; i < a.size(); i++) v[i] = {a[i] % MOD, 1};",
      "        return Tree(v);",
      "    }",
      "    Tree make(int n) { return make(vector<long long>(n, 0)); }",
      "}",
      "auto ${1:seg} = RangeAffineSum::make(${2:a});  // ${2}: size n or vector",
      "// ${1}.range_update(l, r, {mul, add});  ${1}.range_query(l, r).sum;"
    ],
    "description": "Range affine update / range sum modulo 998244353 plus a ready variable."
