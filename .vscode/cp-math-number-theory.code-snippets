      "        auto f = [&](ull v) { return (ull)(((unsigned __int128)v * v + c) % n); };",
      "        while (d == 1) {",
      "            x = f(x), y = f(f(y));",
      "            d = std::gcd(x > y ? x - y : y - x, n);",
      "        }",
      "        if (d != n) return d;",
      "    }",
      "}",
