      "                  vector<bool>& diag1, vector<bool>& diag2) {",
      "    if (col == n) return true;",
      "    for (int row = 0; row < n; row++) {",
      "        if (!cols[row] && !diag1[row + col] && !diag2[row - col + n - 1]) {",
      "            queens[col] = row;",
      "            cols[row] = diag1[row + col] = diag2[row - col + n - 1] = true;",
      "",
      "            if (solveNQueens(col + 1, n, queens, cols, diag1, diag2)) return true;",
      "",
      "            cols[row] = diag1[row + col] = diag2[row - col + n - 1] = false;",
      "        }",
      "    }",
      "    return false;",
      "}",
      "",
      "vector<int> nQueens(int n) {",
      "    vector<int> queens(n);",
      "    vector<bool> cols(n, false), diag1(2 * n, false), diag2(2 * n, false);",
      "    if (solveNQueens(0, n, queens, cols, diag1, diag2)) return queens;",
      "    return {};",
      "}"
