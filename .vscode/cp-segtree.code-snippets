      "            if (pos <= mid) { int c = add(t[prev].l, lo, mid, pos); t[cur].l = c; }",
      "            else { int c = add(t[prev].r, mid + 1, hi, pos); t[cur].r = c; }",
      "        }",
      "        return cur;",
      "    }",
      "    void push_value(int v) { int r = add(roots.back(), 0, n - 1, v); roots.push_back(r); }",
      "    void build(const vector<int> &a) { for (int x : a) push_value(x); }",
      "    int kth(int l, int r, int k) const {  // a[l..r] inclusive, 1 <= k <= r-l+1",
