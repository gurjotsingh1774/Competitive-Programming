      "    PersistentSegTree(int n_ = 1) : n(n_) { t.push_back(Node()); roots.push_back(0); }",
      "    int add(int prev, int lo, int hi, int pos) {",
      "        int cur = (int)t.size();",
      "        t.push_back(t[prev]);",
      "        t[cur].cnt++;",
      "        if (lo < hi) {",
