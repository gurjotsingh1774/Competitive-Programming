  "Li Chao Tree": {
    "prefix": [
      "cp-li-chao"
    ],
    "body": [
      "// LiChao: minimum of lines y = m*x + b at integer x in [lo, hi]. Insert O(log C), query O(log C).",
      "// For maximum, insert (-m, -b) and negate the answer.",
      "struct LiChao {",
      "    struct Line {",
      "        ll m, b;",
      "        ll eval(ll x) const { return m * x + b; }",
      "    };",
      "    struct Node { Line line; int l = -1, r = -1; };",
      "    ll lo, hi;",
      "    vector<Node> t;",
      "    LiChao(ll lo_, ll hi_) : lo(lo_), hi(hi_) { t.push_back({{0, (ll)4e18}, -1, -1}); }",
      "    void add_line(ll m, ll b) { insert(0, lo, hi, {m, b}); }",
      "    void insert(int o, ll l, ll r, Line nw) {",
      "        ll mid = l + (r - l) / 2;",
      "        bool lef = nw.eval(l) < t[o].line.eval(l), md = nw.eval(mid) < t[o].line.eval(mid);",
      "        if (md) swap(t[o].line, nw);",
      "        if (l == r) return;",
      "        if (lef != md) {",
      "            if (t[o].l < 0) { t[o].l = t.size(); t.push_back({nw, -1, -1}); }",
      "            else insert(t[o].l, l, mid, nw);",
      "        } else {",
      "            if (t[o].r < 0) { t[o].r = t.size(); t.push_back({nw, -1, -1}); }",
      "            else insert(t[o].r, mid + 1, r, nw);",
      "        }",
      "    }",
      "    ll query(ll x) const {",
      "        int o = 0;",
      "        ll l = lo, r = hi, res = LLONG_MAX;",
      "        while (o >= 0) {",
      "            res = min(res, t[o].line.eval(x));",
      "            if (l == r) break;",
      "            ll mid = l + (r - l) / 2;",
      "            if (x <= mid) o = t[o].l, r = mid;",
      "            else o = t[o].r, l = mid + 1;",
      "        }",
      "        return res;",
      "    }",
      "};"
    ],
    "description": "Li Chao Tree - Competitive programming template"
  },
  "Segment Tree (Iterative, Monoid)": {
    "prefix": [
      "cp-segtree",
      "cp-seg"
