  "Segment Tree (Iterative, Monoid)": {
    "prefix": [
      "cp-segtree",
      "cp-seg"
    ],
    "body": [
      "// Iterative bottom-up segment tree over any monoid (associative `combine` + `identity`).",
      "// Indices are 0-indexed, ranges are half-open [l, r). Non-commutative ops are handled correctly.",
      "template <class T, class Op> struct SegTree {",
      "    int n;           // Array length (0-indexed indices: 0 to n-1)",
      "    T identity;      // Neutral identity element (e.g. 0 for sum, inf for min)",
      "    Op combine;      // Associative binary operation (Node combine(Node a, Node b))",
      "    vector<T> tree;  // Flat 2*n tree buffer; leaf for 0-indexed index i is at tree[n + i]",
      "",
      "    // Initializes empty SegTree of size n with identity elements (0-indexed: 0 to n-1)",
      "    SegTree(int n_, T identity_, Op combine_) : n(n_), identity(identity_), combine(combine_), tree(2 * n_, identity_) {}",
      "",
      "    // Builds SegTree in O(n) from 0-indexed vector a of length n",
      "    SegTree(const vector<T> &a, T identity_, Op combine_) : SegTree((int)a.size(), identity_, combine_) {",
      "        for (int i = 0; i < n; i++) tree[n + i] = a[i];",
      "        for (int i = n - 1; i > 0; i--) tree[i] = combine(tree[2 * i], tree[2 * i + 1]);",
      "    }",
      "",
      "    // Overwrites a[i] = value at 0-indexed position i (0 <= i < n); O(log n)",
      "    void point_set(int i, T value) {",
      "        for (tree[i += n] = value; i > 1; i >>= 1) tree[i >> 1] = combine(tree[i & ~1], tree[i | 1]);",
      "    }",
      "",
      "    // In-place updates a[i] = combine(a[i], value) at 0-indexed position i (0 <= i < n); O(log n)",
      "    void point_update(int i, T value) { point_set(i, combine(tree[i + n], value)); }",
      "",
      "    // Returns element value at 0-indexed position i (0 <= i < n); O(1)",
      "    T point_get(int i) const { return tree[i + n]; }",
      "",
      "    // Range query: combines a[l..r-1] on 0-indexed half-open interval [l, r); O(log n)",
      "    T range_query(int l, int r) const {",
      "        T left_acc = identity, right_acc = identity;",
      "        for (l += n, r += n; l < r; l >>= 1, r >>= 1) {",
      "            if (l & 1) left_acc = combine(left_acc, tree[l++]);",
      "            if (r & 1) right_acc = combine(tree[--r], right_acc);",
      "        }",
      "        return combine(left_acc, right_acc);",
      "    }",
      "",
      "    // All-element query: combines whole array a[0..n-1]; O(log n)",
      "    T all_query() const { return range_query(0, n); }",
      "};"
    ],
    "description": "Iterative segment tree for any monoid (0-indexed indices, half-open ranges [l, r)). All point updates and range queries in O(log n)."
  },
