  "Lazy Segment Tree": {
    "prefix": [
      "cp-lazy-segtree",
      "cp-lazy",
      "cp-lseg"
    ],
    "body": [
      "// Lazy segment tree (range update + range query). 0-based, half-open [l, r).",
      "//   Node            : aggregate stored per segment          Tag : pending update",
      "//   combine         : Node x Node -> Node (associative)     apply_tag(f, x)    : apply Tag f to Node x",
      "//   node_id()       : identity Node                         compose_tag(f, g)  : Tag \"f after g\"",
      "//   tag_id()        : identity Tag",
      "template <class Node, Node (*combine)(Node, Node), Node (*node_id)(), class Tag, Node (*apply_tag)(Tag, Node), Tag (*compose_tag)(Tag, Tag), Tag (*tag_id)()>",
      "struct LazySegTree {",
      "    int n, size, lg;",
      "    vector<Node> data;",
      "    vector<Tag> lazy;",
      "",
      "    LazySegTree() : LazySegTree(0) {}",
      "    explicit LazySegTree(int n_) : LazySegTree(vector<Node>(n_, node_id())) {}",
      "    explicit LazySegTree(const vector<Node> &init) : n((int)init.size()) {",
      "        lg = 0;",
      "        while ((1 << lg) < n) lg++;",
      "        size = 1 << lg;",
      "        data.assign(2 * size, node_id());",
      "        lazy.assign(size, tag_id());",
      "        for (int i = 0; i < n; i++) data[size + i] = init[i];",
      "        for (int i = size - 1; i >= 1; i--) pull(i);",
      "    }",
      "",
      "    // overwrite the element at index i",
      "    void point_set(int i, Node value) {",
      "        assert(0 <= i && i < n);",
      "        i += size;",
      "        for (int h = lg; h >= 1; h--) push_down(i >> h);",
      "        data[i] = value;",
      "        for (int h = 1; h <= lg; h++) pull(i >> h);",
      "    }",
      "",
      "    // value at index i",
      "    Node point_query(int i) {",
      "        assert(0 <= i && i < n);",
      "        i += size;",
      "        for (int h = lg; h >= 1; h--) push_down(i >> h);",
      "        return data[i];",
      "    }",
      "",
      "    // aggregate over [l, r)",
      "    Node range_query(int l, int r) {",
      "        assert(0 <= l && l <= r && r <= n);",
      "        if (l == r) return node_id();",
      "        l += size, r += size;",
      "        for (int h = lg; h >= 1; h--) {",
      "            if (((l >> h) << h) != l) push_down(l >> h);",
      "            if (((r >> h) << h) != r) push_down((r - 1) >> h);",
      "        }",
      "        Node left_acc = node_id(), right_acc = node_id();",
      "        while (l < r) {",
      "            if (l & 1) left_acc = combine(left_acc, data[l++]);",
      "            if (r & 1) right_acc = combine(data[--r], right_acc);",
      "            l >>= 1, r >>= 1;",
      "        }",
      "        return combine(left_acc, right_acc);",
      "    }",
      "",
      "    // aggregate over the whole array",
      "    Node total_query() { return data[1]; }",
      "",
      "    // apply tag to a single index",
      "    void point_update(int i, Tag tag) {",
      "        assert(0 <= i && i < n);",
      "        i += size;",
      "        for (int h = lg; h >= 1; h--) push_down(i >> h);",
      "        data[i] = apply_tag(tag, data[i]);",
      "        for (int h = 1; h <= lg; h++) pull(i >> h);",
      "    }",
      "",
      "    // apply tag to every index in [l, r)",
      "    void range_update(int l, int r, Tag tag) {",
      "        assert(0 <= l && l <= r && r <= n);",
      "        if (l == r) return;",
      "        l += size, r += size;",
      "        for (int h = lg; h >= 1; h--) {",
      "            if (((l >> h) << h) != l) push_down(l >> h);",
      "            if (((r >> h) << h) != r) push_down((r - 1) >> h);",
      "        }",
      "        {",
      "            int l2 = l, r2 = r;",
      "            while (l < r) {",
      "                if (l & 1) apply_all(l++, tag);",
      "                if (r & 1) apply_all(--r, tag);",
      "                l >>= 1, r >>= 1;",
      "            }",
      "            l = l2, r = r2;",
      "        }",
      "        for (int h = 1; h <= lg; h++) {",
      "            if (((l >> h) << h) != l) pull(l >> h);",
      "            if (((r >> h) << h) != r) pull((r - 1) >> h);",
      "        }",
      "    }",
      "",
      "    // Largest r in [start, n] such that pred(range_query(start, r)) is true (pred must be monotone,",
      "    // pred(node_id()) must be true). Index r is the first position that breaks pred (or n).",
      "    template <class Pred> int max_right(int start, Pred pred) {",
      "        assert(0 <= start && start <= n);",
      "        assert(pred(node_id()));",
      "        if (start == n) return n;",
      "        start += size;",
      "        for (int h = lg; h >= 1; h--) push_down(start >> h);",
      "        Node acc = node_id();",
      "        do {",
      "            while (start % 2 == 0) start >>= 1;",
      "            if (!pred(combine(acc, data[start]))) {",
      "                while (start < size) {",
      "                    push_down(start);",
      "                    start = 2 * start;",
      "                    if (pred(combine(acc, data[start]))) {",
      "                        acc = combine(acc, data[start]);",
      "                        start++;",
      "                    }",
      "                }",
      "                return start - size;",
      "            }",
      "            acc = combine(acc, data[start]);",
      "            start++;",
      "        } while ((start & -start) != start);",
      "        return n;",
      "    }",
      "",
      "  private:",
      "    void pull(int k) { data[k] = combine(data[2 * k], data[2 * k + 1]); }",
      "    void apply_all(int k, Tag f) {",
      "        data[k] = apply_tag(f, data[k]);",
      "        if (k < size) lazy[k] = compose_tag(f, lazy[k]);",
      "    }",
      "    void push_down(int k) {",
      "        apply_all(2 * k, lazy[k]);",
      "        apply_all(2 * k + 1, lazy[k]);",
      "        lazy[k] = tag_id();",
      "    }",
      "};"
    ],
    "description": "Lazy segment tree: point_set / point_query / range_query [l, r) / total_query / point_update / range_update / max_right. Needs Node, combine, node_id, Tag, apply_tag, compose_tag, tag_id - use the lseg-* snippets for ready-made instantiations."
  },
