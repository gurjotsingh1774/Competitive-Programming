    "body": [
      "// Iterative bottom-up segment tree over any monoid (associative `combine` + `identity`).",
      "// Indices are 0-based, ranges are half-open [l, r). Non-commutative ops are handled correctly.",
      "template <class T, class Op> struct SegTree {",
      "    int n;",
      "    T identity;",
      "    Op combine;",
      "    vector<T> tree;",
      "    SegTree(int n_, T identity_, Op combine_) : n(n_), identity(identity_), combine(combine_), tree(2 * n_, identity_) {}",
      "    SegTree(const vector<T> &a, T identity_, Op combine_) : SegTree((int)a.size(), identity_, combine_) {",
      "        for (int i = 0; i < n; i++) tree[n + i] = a[i];",
      "        for (int i = n - 1; i > 0; i--) tree[i] = combine(tree[2 * i], tree[2 * i + 1]);",
      "    }",
      "    // overwrite a[i] = value",
      "    void point_set(int i, T value) {",
      "        for (tree[i += n] = value; i > 1; i >>= 1) tree[i >> 1] = combine(tree[i & ~1], tree[i | 1]);",
      "    }",
      "    // a[i] = combine(a[i], value)   (e.g. += for sum, min= for min)",
      "    void point_update(int i, T value) { point_set(i, combine(tree[i + n], value)); }",
      "    T point_get(int i) const { return tree[i + n]; }",
      "    // combine of a[l..r-1]",
      "    T range_query(int l, int r) const {",
      "        T left_acc = identity, right_acc = identity;",
      "        for (l += n, r += n; l < r; l >>= 1, r >>= 1) {",
      "            if (l & 1) left_acc = combine(left_acc, tree[l++]);",
      "            if (r & 1) right_acc = combine(tree[--r], right_acc);",
      "        }",
      "        return combine(left_acc, right_acc);",
      "    }",
      "    T all_query() const { return range_query(0, n); }",
      "};"
    ],
    "description": "Iterative segment tree for any monoid. point_set / point_update / point_get / range_query [l, r) / all_query, all O(log n). Pair with the seg-* instantiation snippets (seg-sum, seg-min, seg-max, seg-gcd, seg-xor, seg-minidx, seg-maxidx, seg-mulmod, seg-custom)."
  },
