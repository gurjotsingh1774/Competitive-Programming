{
  "Binary Heap (Min / Max Heap)": {
    "prefix": [
      "cp-heap",
      "cp-binary-heap"
    ],
    "body": [
      "#include<vector>",
      "#include<stdexcept>",
      "#include<algorithm>",
      "",
      "template <typename T, typename Compare = std::less<T>>",
      "class BinaryHeap {",
      "private:",
      "    std::vector<T> data;  // 0-indexed array storage for complete binary tree",
      "    Compare comp;         // Comparator (std::less<T> for Min-Heap, std::greater<T> for Max-Heap)",
      "",
      "    // 0-indexed parent index: (i - 1) / 2",
      "    int parent(int i) { return (i - 1) / 2; }",
      "",
      "    // 0-indexed left child index: 2 * i + 1",
      "    int left(int i) { return 2 * i + 1; }",
      "",
      "    // 0-indexed right child index: 2 * i + 2",
      "    int right(int i) { return 2 * i + 2; }",
      "",
      "    // Sifts up element at 0-indexed position i to restore heap invariant; O(log n)",
      "    void siftUp(int i) {",
      "        while (i > 0 && comp(data[i], data[parent(i)])) {",
      "            std::swap(data[i], data[parent(i)]);",
      "            i = parent(i);",
      "        }",
      "    }",
      "",
      "    // Sifts down element at 0-indexed position i to restore heap invariant; O(log n)",
      "    void siftDown(int i) {",
      "        int best = i;",
      "        int l = left(i), r = right(i);",
      "        if (l < (int)data.size() && comp(data[l], data[best])) best = l;",
      "        if (r < (int)data.size() && comp(data[r], data[best])) best = r;",
      "        if (best != i) {",
      "            std::swap(data[i], data[best]);",
      "            siftDown(best);",
      "        }",
      "    }",
      "",
      "public:",
      "    // Default constructor: creates empty heap",
      "    BinaryHeap() = default;",
      "",
      "    // Linear-time build from existing 0-indexed vector; O(n)",
      "    BinaryHeap(const std::vector<T>& arr) : data(arr) {",
      "        for (int i = (data.size() / 2) - 1; i >= 0; --i) {",
      "            siftDown(i);",
      "        }",
      "    }",
      "",
      "    // Pushes value into heap; O(log n)",
      "    void push(T val) {",
      "        data.push_back(val);",
      "        siftUp(data.size() - 1);",
      "    }",
      "",
      "    // Returns top/root element at 0-indexed position 0 (min for std::less); O(1)",
      "    T top() const {",
      "        if (data.empty()) throw std::out_of_range(\"Heap is empty\");",
      "        return data[0];",
      "    }",
      "",
      "    // Removes top/root element from heap; O(log n)",
      "    void pop() {",
      "        if (data.empty()) throw std::out_of_range(\"Heap is empty\");",
      "        data[0] = data.back();",
      "        data.pop_back();",
      "        if (!data.empty()) siftDown(0);",
      "    }",
      "",
      "    // Checks if heap has 0 elements",
      "    bool empty() const { return data.empty(); }",
      "",
      "    // Number of elements in heap",
      "    size_t size() const { return data.size(); }",
      "};"
    ],
    "description": "Binary Heap stored in 0-indexed array with O(log n) push/pop and O(1) top."
  },
