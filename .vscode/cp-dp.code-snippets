      "    vector<vector<int>> dp(n + 1, vector<int>(m + 1, 0));",
      "    for (int i = n - 1; i >= 0; i--)",
      "        for (int j = m - 1; j >= 0; j--)",
      "            dp[i][j] = a[i] == b[j] ? dp[i + 1][j + 1] + 1 : max(dp[i + 1][j], dp[i][j + 1]);",
      "    string r;",
      "    for (int i = 0, j = 0; i < n && j < m;) {",
      "        if (a[i] == b[j]) r += a[i], i++, j++;",
      "        else if (dp[i + 1][j] >= dp[i][j + 1]) i++;",
      "        else j++;",
      "    }",
      "    return r;",
      "}"
