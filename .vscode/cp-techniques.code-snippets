    "body": [
      "template <class T> struct Compressor {",
      "    vector<T> vals;   // sorted distinct values (reverse lookup: vals[rank])",
      "    vector<int> rnk;  // rnk[i] = rank of a[i] in O(1) without binary search",
      "",
      "    Compressor() = default;",
      "    Compressor(const vector<T> &a) { init(a); }",
      "",
      "    void init(const vector<T> &a) {",
      "        int n = a.size();",
      "        rnk.assign(n, 0);",
      "        vals.clear();",
      "        vector<int> ord(n);",
      "        iota(ord.begin(), ord.end(), 0);",
      "        sort(ord.begin(), ord.end(), [&](int i, int j) { return a[i] < a[j]; });",
      "        for (int i = 0; i < n; i++) {",
      "            if (!i || a[ord[i]] != a[ord[i - 1]]) vals.push_back(a[ord[i]]);",
      "            rnk[ord[i]] = (int)vals.size() - 1;",
      "        }",
      "    }",
      "",
      "    int size() const { return (int)vals.size(); }",
      "    int operator[](int i) const { return rnk[i]; }  // O(1) rank of a[i]",
      "    const T &value(int rank) const { return vals[rank]; }",
      "",
      "    // Rank lookup via binary search for arbitrary/query values:",
      "    // If x is present, returns its rank; if absent, returns rank_leq (largest rank with val <= x, or -1).",
      "    int rank(const T &x) const {",
      "        return (int)(upper_bound(vals.begin(), vals.end(), x) - vals.begin()) - 1;",
      "    }",
      "    int rank_leq(const T &x) const { return rank(x); }",
      "    int rank_lt(const T &x) const {",
      "        return (int)(lower_bound(vals.begin(), vals.end(), x) - vals.begin()) - 1;",
      "    }",
      "    int rank_geq(const T &x) const {",
      "        return (int)(lower_bound(vals.begin(), vals.end(), x) - vals.begin());",
      "    }",
      "    int rank_gt(const T &x) const {",
      "        return (int)(upper_bound(vals.begin(), vals.end(), x) - vals.begin());",
      "    }",
      "    int rank_exact(const T &x) const {",
      "        int r = rank(x);",
      "        return (r >= 0 && vals[r] == x) ? r : -1;",
      "    }",
      "};"
    ],
