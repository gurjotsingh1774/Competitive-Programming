    "body": [
      "#include<iostream>",
      "",
      "template <typename T>",
      "class BST {",
      "private:",
      "    struct Node {",
      "        T val;        // Stored value in node",
      "        Node* left;   // Left child pointer (all values in left subtree < val)",
      "        Node* right;  // Right child pointer (all values in right subtree > val)",
      "        Node(T v) : val(v), left(nullptr), right(nullptr) {}",
      "    };",
      "    Node* root = nullptr;  // Root of BST",
      "",
      "    // Recursive helper to insert val into subtree rooted at node; O(h)",
      "    Node* insertNode(Node* node, T val) {",
      "        if (!node) return new Node(val);",
      "        if (val < node->val) node->left = insertNode(node->left, val);",
      "        else if (val > node->val) node->right = insertNode(node->right, val);",
      "        return node;",
      "    }",
      "",
      "    // Finds node with minimum value in subtree (leftmost node); O(h)",
      "    Node* findMin(Node* node) {",
      "        while (node && node->left) node = node->left;",
      "        return node;",
      "    }",
      "",
      "    // Recursive helper to delete key from subtree rooted at node; O(h)",
      "    Node* deleteNode(Node* node, T key) {",
      "        if (!node) return nullptr;",
      "        if (key < node->val) {",
      "            node->left = deleteNode(node->left, key);",
      "        } else if (key > node->val) {",
      "            node->right = deleteNode(node->right, key);",
      "        } else {",
      "            // Case 1 & 2: 0 or 1 child",
      "            if (!node->left) {",
      "                Node* temp = node->right;",
      "                delete node;",
      "                return temp;",
      "            } else if (!node->right) {",
      "                Node* temp = node->left;",
      "                delete node;",
      "                return temp;",
      "            }",
      "            // Case 3: 2 children - find in-order successor (min in right subtree)",
      "            Node* temp = findMin(node->right);",
      "            node->val = temp->val;",
      "            node->right = deleteNode(node->right, temp->val);",
      "        }",
      "        return node;",
      "    }",
      "",
      "    // Recursive helper to search for key in subtree; O(h)",
      "    bool searchNode(Node* node, T key) const {",
      "        if (!node) return false;",
      "        if (node->val == key) return true;",
      "        if (key < node->val) return searchNode(node->left, key);",
      "        return searchNode(node->right, key);",
      "    }",
      "",
      "    // Deallocates all nodes in subtree",
      "    void destroy(Node* node) {",
      "        if (!node) return;",
      "        destroy(node->left);",
      "        destroy(node->right);",
      "        delete node;",
      "    }",
      "",
      "public:",
      "    ~BST() { destroy(root); }",
      "",
      "    // Inserts value into BST; average O(log n), worst O(n)",
      "    void insert(T val) { root = insertNode(root, val); }",
      "",
      "    // Removes key from BST; average O(log n), worst O(n)",
      "    void remove(T key) { root = deleteNode(root, key); }",
      "",
      "    // Searches for key in BST; returns true if present; average O(log n)",
      "    bool search(T key) const { return searchNode(root, key); }",
      "};"
    ],
    "description": "Binary Search Tree supporting average O(log n) insertion, deletion, and search."
  },
  "AVL Tree (Self-Balancing BST)": {
    "prefix": [
      "cp-avl",
      "cp-avl-tree"
    ],
    "body": [
      "#include<iostream>",
      "#include<algorithm>",
      "",
      "template <typename T>",
      "class AVLTree {",
      "private:",
      "    struct Node {",
      "        T key;                  // Stored key",
      "        Node* left = nullptr;   // Left child pointer",
      "        Node* right = nullptr;  // Right child pointer",
      "        int height = 1;         // Height of subtree rooted at this node",
      "        Node(T k) : key(k) {}",
      "    };",
      "    Node* root = nullptr;",
      "",
      "    // Returns height of node (0 for nullptr)",
      "    int getHeight(Node* n) { return n ? n->height : 0; }",
      "",
      "    // Balance factor: height(left) - height(right)",
      "    int getBalance(Node* n) { return n ? getHeight(n->left) - getHeight(n->right) : 0; }",
      "",
      "    // Right rotation around y; O(1)",
      "    Node* rotateRight(Node* y) {",
      "        Node* x = y->left;",
      "        Node* T2 = x->right;",
      "        x->right = y;",
      "        y->left = T2;",
      "        y->height = std::max(getHeight(y->left), getHeight(y->right)) + 1;",
      "        x->height = std::max(getHeight(x->left), getHeight(x->right)) + 1;",
      "        return x;",
      "    }",
      "",
      "    // Left rotation around x; O(1)",
      "    Node* rotateLeft(Node* x) {",
      "        Node* y = x->right;",
      "        Node* T2 = y->left;",
      "        y->left = x;",
      "        x->right = T2;",
      "        y->height = std::max(getHeight(y->left), getHeight(y->right)) + 1;",
      "        x->height = std::max(getHeight(x->left), getHeight(x->right)) + 1;",
      "        return y;",
      "    }",
      "",
      "    // Recursive insertion with AVL rebalancing; worst-case O(log n)",
      "    Node* insertNode(Node* node, T key) {",
      "        if (!node) return new Node(key);",
      "        if (key < node->key) node->left = insertNode(node->left, key);",
      "        else if (key > node->key) node->right = insertNode(node->right, key);",
      "        else return node; // Duplicate keys not inserted",
      "",
      "        node->height = 1 + std::max(getHeight(node->left), getHeight(node->right));",
      "        int balance = getBalance(node);",
      "",
      "        // Left Left Case",
      "        if (balance > 1 && key < node->left->key) return rotateRight(node);",
      "        // Right Right Case",
      "        if (balance < -1 && key > node->right->key) return rotateLeft(node);",
      "        // Left Right Case",
      "        if (balance > 1 && key > node->left->key) {",
      "            node->left = rotateLeft(node->left);",
      "            return rotateRight(node);",
      "        }",
      "        // Right Left Case",
      "        if (balance < -1 && key < node->right->key) {",
      "            node->right = rotateRight(node->right);",
      "            return rotateLeft(node);",
      "        }",
      "        return node;",
      "    }",
      "",
      "public:",
      "    // Inserts key into AVL tree maintaining height balance; guaranteed O(log n)",
      "    void insert(T key) { root = insertNode(root, key); }",
      "};"
    ],
    "description": "Height-balanced AVL Tree guaranteeing worst-case O(log n) operations."
  },
  "Red-Black Tree": {
    "prefix": [
      "cp-rb-tree",
      "cp-rbtree"
