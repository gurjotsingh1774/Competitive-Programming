  "Persistent Segment Tree": {
    "prefix": [
      "cp-persistent-segtree",
      "cp-pst",
      "cp-persist"
    ],
    "body": [
      "struct PersistentSegTree {",
      "    struct Node { int l = 0, r = 0, cnt = 0; };",
      "    int n;",
      "    vector<Node> t;",
      "    vector<int> roots;",
      "    PersistentSegTree(int n_ = 1) : n(n_) { t.push_back(Node()); roots.push_back(0); }",
      "    int add(int prev, int lo, int hi, int pos) {",
      "        int cur = (int)t.size();",
      "        t.push_back(t[prev]);",
      "        t[cur].cnt++;",
      "        if (lo < hi) {",
      "            int mid = (lo + hi) / 2;",
      "            if (pos <= mid) { int c = add(t[prev].l, lo, mid, pos); t[cur].l = c; }",
      "            else { int c = add(t[prev].r, mid + 1, hi, pos); t[cur].r = c; }",
      "        }",
      "        return cur;",
      "    }",
      "    void push_value(int v) { int r = add(roots.back(), 0, n - 1, v); roots.push_back(r); }",
      "    void build(const vector<int> &a) { for (int x : a) push_value(x); }",
      "    int kth(int l, int r, int k) const {  // a[l..r] inclusive, 1 <= k <= r-l+1",
      "        int u = roots[r + 1], v = roots[l], lo = 0, hi = n - 1;",
      "        while (lo < hi) {",
      "            int mid = (lo + hi) / 2, c = t[t[u].l].cnt - t[t[v].l].cnt;",
      "            if (k <= c) u = t[u].l, v = t[v].l, hi = mid;",
      "            else k -= c, u = t[u].r, v = t[v].r, lo = mid + 1;",
      "        }",
      "        return lo;",
      "    }",
      "    int count_leq(int l, int r, int x) const {  // elements <= x in a[l..r]",
      "        if (x < 0) return 0;",
      "        if (x >= n - 1) return r - l + 1;",
      "        int u = roots[r + 1], v = roots[l], lo = 0, hi = n - 1, res = 0;",
      "        while (lo < hi) {",
      "            int mid = (lo + hi) / 2;",
      "            if (x <= mid) u = t[u].l, v = t[v].l, hi = mid;",
      "            else res += t[t[u].l].cnt - t[t[v].l].cnt, u = t[u].r, v = t[v].r, lo = mid + 1;",
      "        }",
      "        return res + t[u].cnt - t[v].cnt;",
      "    }",
      "    int count_range(int l, int r, int low, int high) const {",
      "        if (low > high) return 0;",
      "        return count_leq(l, r, high) - count_leq(l, r, low - 1);",
      "    }",
      "};"
    ],
    "description": "Persistent (path-copying) segment tree over values: kth(l, r, k), count_leq(l, r, x), count_range(l, r, low, high) on a[l..r] inclusive, O(log n) each. Use pst-init to coordinate-compress and build."
  },
