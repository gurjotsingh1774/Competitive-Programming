      "        Matrix r(n, o.m);",
      "        for (int i = 0; i < n; i++)",
      "            for (int k = 0; k < m; k++)",
      "                if (a[i][k].x)",
      "                    for (int j = 0; j < o.m; j++)",
      "                        r.a[i][j] += a[i][k] * o.a[k][j];",
      "        return r;",
      "    }",
      "    Matrix power(ll e) const {",
      "        Matrix r = identity(n), b = *this;",
      "        for (; e; e >>= 1, b = b * b) if (e & 1) r = r * b;",
      "        return r;",
      "    }",
      "    mint det() const {",
      "        Matrix t = *this;",
      "        mint d = 1;",
      "        for (int c = 0; c < n; c++) {",
      "            int p = -1;",
      "            for (int r = c; r < n; r++) if (t.a[r][c].x) { p = r; break; }",
      "            if (p < 0) return 0;",
      "            if (p != c) swap(t.a[p], t.a[c]), d = -d;",
      "            d *= t.a[c][c];",
      "            mint iv = t.a[c][c].inv();",
      "            for (int r = c + 1; r < n; r++) {",
      "                mint f = t.a[r][c] * iv;",
      "                if (f.x) for (int k = c; k < n; k++) t.a[r][k] -= f * t.a[c][k];",
      "            }",
      "        }",
      "        return d;",
      "    }",
      "    int rank() const {",
      "        Matrix t = *this;",
