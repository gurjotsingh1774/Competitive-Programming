      "// Solves A x = b over Z_p. Returns false if inconsistent; otherwise one solution.",
      "inline bool solve_linear(Matrix A, vector<mint> b, vector<mint> &x) {",
      "    int n = A.n, m = A.m;",
      "    for (int i = 0; i < n; i++) A.a[i].push_back(b[i]);",
      "    vector<int> where(m, -1);",
      "    int row = 0;",
      "    for (int c = 0; c < m && row < n; c++) {",
      "        int p = -1;",
      "        for (int r = row; r < n; r++) if (A.a[r][c].x) { p = r; break; }",
      "        if (p < 0) continue;",
      "        swap(A.a[p], A.a[row]);",
      "        mint iv = A.a[row][c].inv();",
      "        for (int k = c; k <= m; k++) A.a[row][k] *= iv;",
      "        for (int r = 0; r < n; r++) if (r != row && A.a[r][c].x) {",
      "            mint f = A.a[r][c];",
      "            for (int k = c; k <= m; k++) A.a[r][k] -= f * A.a[row][k];",
      "        }",
      "        where[c] = row++;",
      "    }",
      "    for (int r = row; r < n; r++) if (A.a[r][m].x) return false;",
      "    x.assign(m, 0);",
      "    for (int c = 0; c < m; c++) if (where[c] >= 0) x[c] = A.a[where[c]][m];",
      "    return true;",
      "}"
    ],
