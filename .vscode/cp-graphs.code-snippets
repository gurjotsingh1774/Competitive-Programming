      "        while (!q.empty()) {",
      "            int u = q.front();",
      "            q.pop();",
      "            for (int id : g[u])",
      "                if (e[id].cap > 0 && level[e[id].to] < 0)",
      "                    level[e[id].to] = level[u] + 1, q.push(e[id].to);",
      "        }",
      "        return level[t] >= 0;",
      "    }",
      "    T dfs(int u, int t, T f) {",
      "        if (u == t) return f;",
