      "template <typename T>",
      "class SinglyLinkedList {",
      "private:",
      "    struct Node {",
      "        T val;",
      "        Node* next;",
      "        Node(T v) : val(v), next(nullptr) {}",
      "    };",
      "    Node* head;",
      "    size_t sz;",
      "",
      "public:",
      "    SinglyLinkedList() : head(nullptr), sz(0) {}",
      "",
      "    ~SinglyLinkedList() {",
      "        clear();",
      "    }",
      "",
      "    void push_front(T val) {",
      "        Node* newNode = new Node(val);",
      "        newNode->next = head;",
      "        head = newNode;",
      "        sz++;",
      "    }",
      "",
      "    void push_back(T val) {",
      "        Node* newNode = new Node(val);",
      "        if (!head) {",
      "            head = newNode;",
      "        } else {",
      "            Node* cur = head;",
      "            while (cur->next) cur = cur->next;",
      "            cur->next = newNode;",
      "        }",
      "        sz++;",
      "    }",
      "",
      "    bool pop_front() {",
      "        if (!head) return false;",
      "        Node* temp = head;",
      "        head = head->next;",
      "        delete temp;",
      "        sz--;",
      "        return true;",
      "    }",
      "",
      "    bool remove(T val) {",
      "        if (!head) return false;",
      "        if (head->val == val) {",
      "            return pop_front();",
      "        }",
      "        Node* cur = head;",
      "        while (cur->next && cur->next->val != val) {",
      "            cur = cur->next;",
      "        }",
      "        if (!cur->next) return false;",
      "        Node* target = cur->next;",
      "        cur->next = cur->next->next;",
      "        delete target;",
      "        sz--;",
      "        return true;",
      "    }",
      "",
      "    void reverse() {",
      "        Node* prev = nullptr;",
      "        Node* cur = head;",
      "        Node* nxt = nullptr;",
      "        while (cur) {",
      "            nxt = cur->next;",
      "            cur->next = prev;",
      "            prev = cur;",
      "            cur = nxt;",
      "        }",
      "        head = prev;",
      "    }",
      "",
      "    bool find(T val) const {",
      "        Node* cur = head;",
      "        while (cur) {",
      "            if (cur->val == val) return true;",
      "            cur = cur->next;",
      "        }",
      "        return false;",
      "    }",
      "",
      "    size_t size() const { return sz; }",
      "    bool empty() const { return head == nullptr; }",
      "",
      "    void clear() {",
      "        while (head) {",
      "            Node* temp = head;",
      "            head = head->next;",
      "            delete temp;",
      "        }",
      "        sz = 0;",
      "    }",
      "};"
