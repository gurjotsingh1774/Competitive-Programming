      "#include<vector>",
      "#include<list>",
      "#include<utility>",
      "#include<stdexcept>",
      "",
      "template <typename K, typename V>",
      "class ChainingHashTable {",
      "private:",
      "    std::vector<std::list<std::pair<K, V>>> table;",
      "    size_t num_elements = 0;",
      "    size_t num_buckets;",
      "",
      "    size_t hash(const K& key) const {",
      "        return std::hash<K>{}(key) % num_buckets;",
      "    }",
      "",
      "public:",
      "    ChainingHashTable(size_t buckets = 101) : num_buckets(buckets), table(buckets) {}",
      "",
      "    void insert(const K& key, const V& value) {",
      "        size_t b = hash(key);",
      "        for (auto& pair : table[b]) {",
      "            if (pair.first == key) {",
      "                pair.second = value; // Update existing",
      "                return;",
      "            }",
      "        }",
      "        table[b].emplace_back(key, value);",
      "        num_elements++;",
      "    }",
      "",
      "    bool find(const K& key, V& out_val) const {",
      "        size_t b = hash(key);",
      "        for (const auto& pair : table[b]) {",
      "            if (pair.first == key) {",
      "                out_val = pair.second;",
      "                return true;",
      "            }",
      "        }",
      "        return false;",
      "    }",
      "",
      "    bool erase(const K& key) {",
      "        size_t b = hash(key);",
      "        for (auto it = table[b].begin(); it != table[b].end(); ++it) {",
      "            if (it->first == key) {",
      "                table[b].erase(it);",
      "                num_elements--;",
      "                return true;",
      "            }",
      "        }",
      "        return false;",
      "    }",
      "",
      "    size_t size() const { return num_elements; }",
      "    bool empty() const { return num_elements == 0; }",
      "};"
    ],
    "description": "Resolves collisions by maintaining a linked list (or dynamic array) of key-value pairs at each hash bucket. When the load factor exceeds a threshold, the table can rehash to maintain expected constant-time operations...."
