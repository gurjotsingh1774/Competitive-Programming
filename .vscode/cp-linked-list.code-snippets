    "body": [
      "#include<iostream>",
      "#include<vector>",
      "",
      "template <typename T>",
      "class SinglyLinkedList {",
      "private:",
      "    struct Node {",
      "        T val;       // Node payload value",
      "        Node* next;  // Pointer to next node (nullptr if end)",
      "        Node(T v) : val(v), next(nullptr) {}",
      "    };",
      "    Node* head;      // Pointer to first node (nullptr if empty)",
      "    size_t sz;       // Total number of nodes in list",
      "",
      "public:",
      "    // Default constructor: creates empty list",
      "    SinglyLinkedList() : head(nullptr), sz(0) {}",
      "",
      "    // Destructor: deallocates all nodes",
      "    ~SinglyLinkedList() { clear(); }",
      "",
      "    // Inserts value at front (head); O(1)",
      "    void push_front(T val) {",
      "        Node* newNode = new Node(val);",
      "        newNode->next = head;",
      "        head = newNode;",
      "        sz++;",
      "    }",
      "",
      "    // Inserts value at back (tail); O(n)",
      "    void push_back(T val) {",
      "        Node* newNode = new Node(val);",
      "        if (!head) {",
      "            head = newNode;",
      "        } else {",
      "            Node* cur = head;",
      "            while (cur->next) cur = cur->next;",
      "            cur->next = newNode;",
      "        }",
      "        sz++;",
      "    }",
      "",
      "    // Removes element at front; returns true if successful, false if empty; O(1)",
      "    bool pop_front() {",
      "        if (!head) return false;",
      "        Node* temp = head;",
      "        head = head->next;",
      "        delete temp;",
      "        sz--;",
      "        return true;",
      "    }",
      "",
      "    // Removes first occurrence of val; returns true if found and removed; O(n)",
      "    bool remove(T val) {",
      "        if (!head) return false;",
      "        if (head->val == val) return pop_front();",
      "        Node* cur = head;",
      "        while (cur->next && cur->next->val != val) cur = cur->next;",
      "        if (!cur->next) return false;",
      "        Node* target = cur->next;",
      "        cur->next = cur->next->next;",
      "        delete target;",
      "        sz--;",
      "        return true;",
      "    }",
      "",
      "    // Reverses list in-place in O(n) time and O(1) space",
      "    void reverse() {",
      "        Node* prev = nullptr;",
      "        Node* cur = head;",
      "        while (cur) {",
      "            Node* nxt = cur->next;",
      "            cur->next = prev;",
      "            prev = cur;",
      "            cur = nxt;",
      "        }",
      "        head = prev;",
      "    }",
      "",
      "    // Checks if value exists in list; O(n)",
      "    bool find(T val) const {",
      "        Node* cur = head;",
      "        while (cur) {",
      "            if (cur->val == val) return true;",
      "            cur = cur->next;",
      "        }",
      "        return false;",
      "    }",
      "",
      "    // Total number of nodes in list",
      "    size_t size() const { return sz; }",
      "",
      "    // Checks if list contains 0 nodes",
      "    bool empty() const { return head == nullptr; }",
      "",
      "    // Clears all nodes",
      "    void clear() {",
      "        while (head) pop_front();",
      "    }",
      "};"
    ],
    "description": "Singly Linked List supporting O(1) push_front, pop_front, and in-place reversal."
  },
