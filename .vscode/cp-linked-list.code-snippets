      "#include<iostream>",
      "",
      "template <typename T>",
      "class DoublyLinkedList {",
      "private:",
      "    struct Node {",
      "        T val;       // Node payload value",
      "        Node* prev;  // Pointer to previous node",
      "        Node* next;  // Pointer to next node",
      "        Node(T v) : val(v), prev(nullptr), next(nullptr) {}",
      "    };",
      "    Node* head;      // Head pointer (nullptr if empty)",
      "    Node* tail;      // Tail pointer (nullptr if empty)",
      "    size_t sz;       // Total number of nodes",
      "",
      "public:",
      "    // Default constructor: creates empty list",
      "    DoublyLinkedList() : head(nullptr), tail(nullptr), sz(0) {}",
      "",
      "    // Destructor: deallocates all nodes",
      "    ~DoublyLinkedList() { clear(); }",
      "",
      "    // Inserts value at front; O(1)",
      "    void push_front(T val) {",
      "        Node* newNode = new Node(val);",
      "        if (!head) {",
      "            head = tail = newNode;",
      "        } else {",
      "            newNode->next = head;",
      "            head->prev = newNode;",
      "            head = newNode;",
      "        }",
      "        sz++;",
      "    }",
      "",
      "    // Inserts value at back; O(1)",
      "    void push_back(T val) {",
      "        Node* newNode = new Node(val);",
      "        if (!tail) {",
      "            head = tail = newNode;",
      "        } else {",
      "            tail->next = newNode;",
      "            newNode->prev = tail;",
      "            tail = newNode;",
      "        }",
      "        sz++;",
      "    }",
      "",
      "    // Removes element from front; returns true if successful; O(1)",
      "    bool pop_front() {",
      "        if (!head) return false;",
      "        Node* temp = head;",
      "        head = head->next;",
      "        if (head) head->prev = nullptr;",
      "        else tail = nullptr;",
      "        delete temp;",
      "        sz--;",
      "        return true;",
      "    }",
      "",
      "    // Removes element from back; returns true if successful; O(1)",
      "    bool pop_back() {",
      "        if (!tail) return false;",
      "        Node* temp = tail;",
      "        tail = tail->prev;",
      "        if (tail) tail->next = nullptr;",
      "        else head = nullptr;",
      "        delete temp;",
      "        sz--;",
      "        return true;",
      "    }",
      "",
      "    // Number of elements in list",
      "    size_t size() const { return sz; }",
      "",
      "    // Checks if list contains 0 nodes",
      "    bool empty() const { return sz == 0; }",
      "",
      "    // Clears all nodes",
      "    void clear() { while (head) pop_front(); }",
      "};"
    ],
    "description": "Doubly Linked List supporting O(1) insertion and deletion at both front and back."
