      "#include<stdexcept>",
      "",
      "template <typename T>",
      "class ListStack {",
      "private:",
      "    struct Node {",
      "        T val;       // Node value",
      "        Node* next;  // Next node down the stack",
      "        Node(T v, Node* nxt) : val(v), next(nxt) {}",
      "    };",
      "    Node* head = nullptr;  // Top of stack pointer",
      "    size_t sz = 0;         // Number of elements in stack",
      "",
      "public:",
      "    ~ListStack() { while (!empty()) pop(); }",
      "",
      "    // Pushes value onto top of stack; O(1)",
      "    void push(T val) {",
      "        head = new Node(val, head);",
      "        sz++;",
      "    }",
      "",
      "    // Pops value from top of stack; throws if empty; O(1)",
      "    void pop() {",
      "        if (!head) throw std::out_of_range(\"Stack underflow\");",
      "        Node* temp = head;",
      "        head = head->next;",
      "        delete temp;",
      "        sz--;",
      "    }",
      "",
      "    // Returns reference to top element; throws if empty; O(1)",
      "    T top() const {",
      "        if (!head) throw std::out_of_range(\"Stack is empty\");",
      "        return head->val;",
      "    }",
      "",
      "    // Checks if stack is empty (0 elements)",
      "    bool empty() const { return head == nullptr; }",
      "",
      "    // Number of elements in stack",
      "    size_t size() const { return sz; }",
      "};"
    ],
    "description": "Linked-list based stack implementation with O(1) push, pop, and top operations."
