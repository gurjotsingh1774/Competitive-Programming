  "Circular Linked List": {
    "prefix": [
      "cp-circular-linked-list"
    ],
    "body": [
      "#include<iostream>",
      "",
      "template <typename T>",
      "class CircularLinkedList {",
      "private:",
      "    struct Node {",
      "        T val;       // Node payload value",
      "        Node* next;  // Pointer to next node",
      "        Node(T v) : val(v), next(nullptr) {}",
      "    };",
      "    Node* tail;      // Points to tail node; tail->next gives head in O(1)",
      "    size_t sz;       // Total number of nodes",
      "",
      "public:",
      "    // Default constructor: creates empty circular list",
      "    CircularLinkedList() : tail(nullptr), sz(0) {}",
      "",
      "    // Destructor: clears all nodes",
      "    ~CircularLinkedList() { clear(); }",
      "",
      "    // Inserts element at front; O(1)",
      "    void push_front(T val) {",
      "        Node* newNode = new Node(val);",
      "        if (!tail) {",
      "            tail = newNode;",
      "            tail->next = tail;",
      "        } else {",
      "            newNode->next = tail->next;",
      "            tail->next = newNode;",
      "        }",
      "        sz++;",
      "    }",
      "",
      "    // Inserts element at back; O(1)",
      "    void push_back(T val) {",
      "        push_front(val);",
      "        tail = tail->next;",
      "    }",
      "",
      "    // Removes front element; O(1)",
      "    bool pop_front() {",
      "        if (!tail) return false;",
      "        Node* head = tail->next;",
      "        if (head == tail) {",
      "            delete head;",
      "            tail = nullptr;",
      "        } else {",
      "            tail->next = head->next;",
      "            delete head;",
      "        }",
      "        sz--;",
      "        return true;",
      "    }",
      "",
      "    // Number of nodes in circular list",
      "    size_t size() const { return sz; }",
      "",
      "    // Checks if circular list has 0 nodes",
      "    bool empty() const { return sz == 0; }",
      "",
      "    // Clears all nodes",
      "    void clear() { while (tail) pop_front(); }",
      "};"
    ],
    "description": "Circular Linked List where the last node points back to the first node (ideal for round-robin simulation)."
  },
