      "    AhoCorasick() { t.emplace_back(); }",
      "    int add(const string &s) {",
      "        int u = 0;",
      "        for (char ch : s) {",
      "            int c = ch - 'a';",
      "            if (t[u].nxt[c] < 0) t[u].nxt[c] = t.size(), t.emplace_back();",
      "            u = t[u].nxt[c];",
      "        }",
      "        end_node.push_back(u);",
      "        return end_node.size() - 1;",
      "    }",
      "    void build() {",
      "        queue<int> q;",
      "        for (int c = 0; c < 26; c++) {",
      "            if (t[0].nxt[c] < 0) t[0].nxt[c] = 0;",
      "            else t[t[0].nxt[c]].fail = 0, q.push(t[0].nxt[c]);",
      "        }",
      "        while (!q.empty()) {",
      "            int u = q.front();",
      "            q.pop(), bfs_order.push_back(u);",
