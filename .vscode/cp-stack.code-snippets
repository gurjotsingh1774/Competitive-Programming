  "Dynamic Array-based Stack": {
    "prefix": [
      "cp-array-stack",
      "cp-stack-array"
    ],
    "body": [
      "#include<vector>",
      "#include<stdexcept>",
      "",
      "template <typename T>",
      "class ArrayStack {",
      "private:",
      "    std::vector<T> data;  // Contiguous dynamic array storage",
      "",
      "public:",
      "    // Pushes value onto top of stack; amortized O(1)",
      "    void push(T val) { data.push_back(val); }",
      "",
      "    // Pops value from top of stack; throws if empty; O(1)",
      "    void pop() {",
      "        if (data.empty()) throw std::out_of_range(\"Stack underflow\");",
      "        data.pop_back();",
      "    }",
      "",
      "    // Returns reference to top element; throws if empty; O(1)",
      "    T top() const {",
      "        if (data.empty()) throw std::out_of_range(\"Stack is empty\");",
      "        return data.back();",
      "    }",
      "",
      "    // Checks if stack contains 0 elements",
      "    bool empty() const { return data.empty(); }",
      "",
      "    // Number of elements in stack",
      "    size_t size() const { return data.size(); }",
      "",
      "    // Clears all elements",
      "    void clear() { data.clear(); }",
      "};"
    ],
    "description": "Dynamic array-based LIFO stack with amortized O(1) operations."
  },
  "Monotonic Stack (Nearest Elements)": {
    "prefix": [
      "cp-monotonic-stack-nearest",
      "cp-nearest-elements"
    ],
    "body": [
      "// nearest_right: first 0-indexed index j > i with cmp(a[j], a[i]) (n if none exists); O(n)",
      "template <class T, class Cmp> vector<int> nearest_right(const vector<T> &a, Cmp cmp) {",
      "    int n = a.size();",
      "    vector<int> res(n, n), st;  // 0-indexed result array",
      "    for (int i = 0; i < n; i++) {",
      "        while (!st.empty() && cmp(a[i], a[st.back()])) {",
      "            res[st.back()] = i;",
      "            st.pop_back();",
      "        }",
      "        st.push_back(i);",
      "    }",
      "    return res;",
      "}",
      "",
      "// nearest_left: last 0-indexed index j < i with cmp(a[j], a[i]) (-1 if none exists); O(n)",
      "template <class T, class Cmp> vector<int> nearest_left(const vector<T> &a, Cmp cmp) {",
      "    int n = a.size();",
      "    vector<int> res(n, -1), st; // 0-indexed result array",
      "    for (int i = n - 1; i >= 0; i--) {",
      "        while (!st.empty() && cmp(a[i], a[st.back()])) {",
      "            res[st.back()] = i;",
      "            st.pop_back();",
      "        }",
      "        st.push_back(i);",
      "    }",
      "    return res;",
      "}"
    ],
    "description": "Computes the nearest greater/smaller element to the left and right of every index in O(n) (0-indexed)."
  },
  "Monotonic Stack (Next Greater/Smaller Values)": {
    "prefix": [
      "cp-monotonic-stack"
    ],
    "body": [
      "#include<vector>",
      "#include<stack>",
      "",
      "struct MonotonicStack {",
      "    // Finds next greater value for each 0-indexed position (returns -1 if none); O(n)",
      "    static std::vector<int> nextGreaterElement(const std::vector<int>& nums) {",
      "        int n = nums.size();",
      "        std::vector<int> result(n, -1);  // 0-indexed result",
      "        std::stack<int> s;               // Stores 0-indexed indices",
      "",
      "        for (int i = 0; i < n; ++i) {",
      "            while (!s.empty() && nums[s.top()] < nums[i]) {",
      "                result[s.top()] = nums[i];",
      "                s.pop();",
      "            }",
      "            s.push(i);",
      "        }",
      "        return result;",
      "    }",
      "",
      "    // Finds next smaller value for each 0-indexed position (returns -1 if none); O(n)",
      "    static std::vector<int> nextSmallerElement(const std::vector<int>& nums) {",
      "        int n = nums.size();",
      "        std::vector<int> result(n, -1);  // 0-indexed result",
      "        std::stack<int> s;",
      "",
      "        for (int i = 0; i < n; ++i) {",
      "            while (!s.empty() && nums[s.top()] > nums[i]) {",
      "                result[s.top()] = nums[i];",
      "                s.pop();",
      "            }",
      "            s.push(i);",
      "        }",
      "        return result;",
      "    }",
      "};"
    ],
    "description": "Next Greater Element (NGE) and Next Smaller Element (NSE) in O(n) using monotonic stack."
  },
  "Expression Conversion: Infix to Postfix (Shunting-Yard)": {
    "prefix": [
      "cp-infix-to-postfix",
      "cp-shunting-yard"
    ],
    "body": [
      "#include<string>",
      "#include<stack>",
      "#include<cctype>",
      "",
      "// Operator precedence: higher value = higher precedence",
      "int getPrecedence(char op) {",
      "    if (op == '^') return 3;",
      "    if (op == '*' || op == '/' || op == '%') return 2;",
      "    if (op == '+' || op == '-') return 1;",
      "    return 0;",
      "}",
      "",
      "// Operator associativity (true for right-associative power operator ^)",
      "bool isRightAssociative(char op) { return op == '^'; }",
      "",
      "// Converts standard infix expression to Reverse Polish Notation (RPN / postfix); O(n)",
      "std::string infixToPostfix(const std::string& expr) {",
      "    std::stack<char> s;",
      "    std::string postfix;",
      "",
      "    for (char c : expr) {",
      "        if (std::isspace(c)) continue;",
      "        if (std::isalnum(c)) {",
      "            postfix += c;",
      "        } else if (c == '(') {",
      "            s.push(c);",
      "        } else if (c == ')') {",
      "            while (!s.empty() && s.top() != '(') {",
      "                postfix += s.top();",
      "                s.pop();",
      "            }",
      "            if (!s.empty()) s.pop(); // Pop '('",
      "        } else {",
      "            while (!s.empty() && s.top() != '(' &&",
      "                   (getPrecedence(s.top()) > getPrecedence(c) ||",
      "                    (getPrecedence(s.top()) == getPrecedence(c) && !isRightAssociative(c)))) {",
      "                postfix += s.top();",
      "                s.pop();",
      "            }",
      "            s.push(c);",
      "        }",
      "    }",
      "",
      "    while (!s.empty()) {",
      "        postfix += s.top();",
      "        s.pop();",
      "    }",
      "    return postfix;",
      "}"
    ],
    "description": "Converts standard infix arithmetic expressions to postfix Reverse Polish Notation using Shunting-yard algorithm."
  },
  "Expression Evaluation: Postfix & Prefix": {
    "prefix": [
      "cp-eval-expression",
      "cp-eval-postfix"
    ],
    "body": [
      "#include<string>",
      "#include<vector>",
      "#include<stack>",
      "#include<sstream>",
      "#include<cmath>",
      "#include<stdexcept>",
      "",
      "// Evaluates single binary operation",
      "long long applyOp(char op, long long a, long long b) {",
      "    switch (op) {",
      "        case '+': return a + b;",
      "        case '-': return a - b;",
      "        case '*': return a * b;",
      "        case '/': return a / b;",
      "        case '^': {",
      "            long long res = 1;",
      "            while (b > 0) {",
      "                if (b & 1) res *= a;",
      "                a *= a;",
      "                b >>= 1;",
      "            }",
      "            return res;",
      "        }",
      "        default: throw std::invalid_argument(\"Unknown operator\");",
      "    }",
      "}",
      "",
      "// Evaluates space-separated postfix expression tokens (e.g. \"3 4 + 2 *\"); O(n)",
      "long long evaluatePostfix(const std::string& expr) {",
      "    std::stack<long long> s;",
      "    std::stringstream ss(expr);",
      "    std::string token;",
      "",
      "    while (ss >> token) {",
      "        if (token.size() == 1 && std::string(\"+-*/^\").find(token[0]) != std::string::npos) {",
      "            if (s.size() < 2) throw std::invalid_argument(\"Malformed postfix expression\");",
      "            long long b = s.top(); s.pop();",
      "            long long a = s.top(); s.pop();",
      "            s.push(applyOp(token[0], a, b));",
      "        } else {",
      "            s.push(std::stoll(token));",
      "        }",
      "    }",
      "",
      "    if (s.size() != 1) throw std::invalid_argument(\"Malformed postfix expression\");",
      "    return s.top();",
      "}"
    ],
    "description": "Evaluates postfix arithmetic expressions in O(n) time using an evaluation stack."
  }
