      "template <class Add, class Rem, class Ans>",
      "void mo_algorithm(int n, vector<MoQuery> qs, Add add, Rem rem, Ans ans) {",
      "    int q = (int)qs.size();",
      "    if (!q) return;",
      "    int block = max(1, (int)(n / sqrt((double)q) + 1));",
      "    sort(qs.begin(), qs.end(), [&](const MoQuery &a, const MoQuery &b) {",
      "        int ba = a.l / block, bb = b.l / block;",
      "        if (ba != bb) return ba < bb;",
      "        return (ba & 1) ? a.r > b.r : a.r < b.r;",
      "    });",
      "    int cl = 0, cr = -1;",
      "    for (auto &x : qs) {",
      "        while (cl > x.l) add(--cl);",
      "        while (cr < x.r) add(++cr);",
      "        while (cl < x.l) rem(cl++);",
      "        while (cr > x.r) rem(cr--);",
      "        ans(x.id);",
      "    }",
      "}"
