      "// Left partition vertices 0..nl-1, Right partition vertices 0..nr-1.",
      "struct HopcroftKarp {",
      "    int nl, nr;",
      "    vector<vector<int>> g;",
      "    vector<int> matchL, matchR, dist;",
      "    HopcroftKarp(int nl_ = 0, int nr_ = 0) : nl(nl_), nr(nr_), g(nl_) {}",
      "    void add_edge(int l, int r) { g[l].push_back(r); }",
      "    bool bfs() {",
      "        queue<int> q;",
      "        dist.assign(nl, -1);",
      "        for (int i = 0; i < nl; i++)",
      "            if (matchL[i] < 0) dist[i] = 0, q.push(i);",
      "        bool found = false;",
      "        while (!q.empty()) {",
      "            int u = q.front();",
      "            q.pop();",
      "            for (int v : g[u]) {",
      "                int w = matchR[v];",
      "                if (w < 0) found = true;",
      "                else if (dist[w] < 0) dist[w] = dist[u] + 1, q.push(w);",
      "            }",
      "        }",
      "        return found;",
      "    }",
      "    bool dfs(int u) {",
      "        for (int v : g[u]) {",
      "            int w = matchR[v];",
      "            if (w < 0 || (dist[w] == dist[u] + 1 && dfs(w))) {",
      "                matchL[u] = v, matchR[v] = u;",
      "                return true;",
      "            }",
      "        }",
      "        dist[u] = -1;",
      "        return false;",
      "    }",
      "    int max_matching() {",
      "        matchL.assign(nl, -1), matchR.assign(nr, -1);",
      "        int res = 0;",
      "        while (bfs())",
      "            for (int i = 0; i < nl; i++)",
      "                if (matchL[i] < 0 && dfs(i)) res++;",
      "        return res;",
      "    }",
      "};"
