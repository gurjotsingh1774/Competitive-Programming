      "template <class F = long long, class C = long long> struct MinCostFlow {",
      "    struct E { int to; F cap; C cost; };",
      "    int n;",
      "    vector<E> e;",
      "    vector<vector<int>> g;",
      "    MinCostFlow(int n_ = 0) : n(n_), g(n_) {}",
      "    int add_edge(int u, int v, F cap, C cost) {",
      "        e.push_back({v, cap, cost}), g[u].push_back(e.size() - 1);",
      "        e.push_back({u, 0, -cost}), g[v].push_back(e.size() - 1);",
      "        return e.size() - 2;",
      "    }",
      "    pair<F, C> flow(int s, int t, F limit = numeric_limits<F>::max()) {",
      "        F total = 0;",
      "        C cost = 0;",
      "        while (total < limit) {",
      "            vector<C> dist(n, numeric_limits<C>::max());",
      "            vector<int> pe(n, -1);",
      "            vector<char> inq(n, 0);",
      "            deque<int> q;",
      "            dist[s] = 0, q.push_back(s);",
      "            while (!q.empty()) {",
      "                int u = q.front();",
      "                q.pop_front(), inq[u] = 0;",
      "                for (int id : g[u])",
      "                    if (e[id].cap > 0 && dist[u] + e[id].cost < dist[e[id].to]) {",
      "                        dist[e[id].to] = dist[u] + e[id].cost, pe[e[id].to] = id;",
      "                        if (!inq[e[id].to]) inq[e[id].to] = 1, q.push_back(e[id].to);",
      "                    }",
      "            }",
      "            if (dist[t] == numeric_limits<C>::max()) break;",
      "            F f = limit - total;",
      "            for (int v = t; v != s; v = e[pe[v] ^ 1].to) f = min(f, e[pe[v]].cap);",
      "            for (int v = t; v != s; v = e[pe[v] ^ 1].to) e[pe[v]].cap -= f, e[pe[v] ^ 1].cap += f;",
      "            total += f, cost += f * dist[t];",
      "        }",
      "        return {total, cost};",
      "    }",
      "};"
