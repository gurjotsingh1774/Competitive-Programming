      "template <class T = long long> struct Dinic {",
      "    struct E { int to; T cap; };",
      "    int n;",
      "    vector<E> e;",
      "    vector<vector<int>> g;",
      "    vector<int> level, it;",
      "    Dinic(int n_ = 0) : n(n_), g(n_) {}",
      "    int add_edge(int u, int v, T cap) {",
      "        e.push_back({v, cap}), g[u].push_back(e.size() - 1);",
      "        e.push_back({u, 0}), g[v].push_back(e.size() - 1);",
      "        return e.size() - 2;",
      "    }",
      "    T flow_on(int id) const { return e[id ^ 1].cap; }",
      "    bool bfs(int s, int t) {",
      "        level.assign(n, -1);",
      "        queue<int> q;",
      "        level[s] = 0, q.push(s);",
      "        while (!q.empty()) {",
      "            int u = q.front();",
      "            q.pop();",
      "            for (int id : g[u])",
      "                if (e[id].cap > 0 && level[e[id].to] < 0)",
      "                    level[e[id].to] = level[u] + 1, q.push(e[id].to);",
      "        }",
      "        return level[t] >= 0;",
      "    }",
      "    T dfs(int u, int t, T f) {",
      "        if (u == t) return f;",
      "        for (int &i = it[u]; i < (int)g[u].size(); i++) {",
      "            int id = g[u][i], v = e[id].to;",
      "            if (e[id].cap > 0 && level[v] == level[u] + 1) {",
      "                T r = dfs(v, t, min(f, e[id].cap));",
      "                if (r > 0) { e[id].cap -= r, e[id ^ 1].cap += r; return r; }",
      "            }",
      "        }",
      "        return 0;",
      "    }",
      "    T max_flow(int s, int t) {",
      "        T flow = 0;",
      "        while (bfs(s, t)) {",
      "            it.assign(n, 0);",
      "            while (T f = dfs(s, t, numeric_limits<T>::max())) flow += f;",
      "        }",
      "        return flow;",
      "    }",
      "    vector<bool> min_cut_side(int s) {",
      "        vector<bool> seen(n, false);",
      "        vector<int> st = {s};",
      "        seen[s] = true;",
      "        while (!st.empty()) {",
      "            int u = st.back();",
      "            st.pop_back();",
      "            for (int id : g[u])",
      "                if (e[id].cap > 0 && !seen[e[id].to])",
      "                    seen[e[id].to] = true, st.push_back(e[id].to);",
      "        }",
      "        return seen;",
      "    }",
      "};"
