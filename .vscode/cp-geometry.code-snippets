      "        for (int i = 0; i < n; i++) {",
      "            if (cross(points[p], points[i], points[q]) > 0) q = i;",
      "        }",
      "        p = q;",
      "    } while (p != leftmost);",
      "",
      "    return hull;",
      "}"
