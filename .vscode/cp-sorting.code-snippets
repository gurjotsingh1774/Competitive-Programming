    "body": [
      "// Sifts down 0-indexed element at position i in heap of size n; O(log n)",
      "void heapify(vector<int>& arr, int n, int i) {",
      "    int largest = i;",
      "    int l = 2 * i + 1, r = 2 * i + 2;  // 0-indexed child indices",
      "    if (l < n && arr[l] > arr[largest]) largest = l;",
      "    if (r < n && arr[r] > arr[largest]) largest = r;",
      "    if (largest != i) {",
      "        swap(arr[i], arr[largest]);",
      "        heapify(arr, n, largest);",
      "    }",
      "}",
      "",
      "// Sorts 0-indexed array arr in-place using Heap Sort; guaranteed O(n log n)",
      "void heapSort(vector<int>& arr) {",
      "    int n = arr.size();",
      "    for (int i = n / 2 - 1; i >= 0; i--) heapify(arr, n, i);  // Build max-heap",
      "    for (int i = n - 1; i > 0; i--) {",
      "        swap(arr[0], arr[i]);                                  // Move current max to end",
      "        heapify(arr, i, 0);",
      "    }",
      "}"
    ],
    "description": "In-place Heap Sort using 0-indexed array with guaranteed O(n log n) worst-case time."
