      "// Sorts 0-indexed array arr in-place using Selection Sort; O(n^2) comparisons, O(n) swaps",
      "void selectionSort(vector<int>& arr) {",
      "    int n = arr.size();",
      "    for (int i = 0; i < n - 1; i++) {  // 0-indexed prefix",
      "        int minIdx = i;",
      "        for (int j = i + 1; j < n; j++) {",
      "            if (arr[j] < arr[minIdx]) minIdx = j;",
      "        }",
      "        if (minIdx != i) swap(arr[i], arr[minIdx]);",
      "    }",
      "}"
    ],
