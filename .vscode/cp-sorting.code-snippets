  "Inversion Counting via Merge Sort": {
    "prefix": [
      "cp-inversion-counting",
      "cp-inversions"
    ],
    "body": [
      "// Counts total inverted pairs (0-indexed indices i < j with a[i] > a[j]); O(n log n)",
      "template <class T> long long inversion_count(vector<T> a) {",
      "    vector<T> buf(a.size());",
      "    function<long long(int, int)> rec = [&](int l, int r) -> long long {",
      "        if (r - l < 2) return 0;",
      "        int m = (l + r) / 2;",
      "        long long res = rec(l, m) + rec(m, r);",
      "        int i = l, j = m, k = l;",
      "        while (i < m || j < r) {",
      "            if (j >= r || (i < m && !(a[j] < a[i]))) buf[k++] = a[i++];",
      "            else res += m - i, buf[k++] = a[j++];",
      "        }",
      "        copy(buf.begin() + l, buf.begin() + r, a.begin() + l);",
      "        return res;",
      "    };",
      "    return rec(0, a.size());  // 0-indexed range [0, n)",
      "}"
    ],
    "description": "Counts total inverted pairs (0-indexed i < j with a[i] > a[j]) in O(n log n) via merge sort."
  },
