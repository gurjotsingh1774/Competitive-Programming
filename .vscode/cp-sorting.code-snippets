      "// Sorts 0-indexed array arr in-place using Insertion Sort; O(n) best, O(n^2) worst",
      "void insertionSort(vector<int>& arr) {",
      "    int n = arr.size();",
      "    for (int i = 1; i < n; i++) {  // 0-indexed index i",
      "        int key = arr[i];",
      "        int j = i - 1;",
      "        while (j >= 0 && arr[j] > key) {",
      "            arr[j + 1] = arr[j];",
      "            j--;",
      "        }",
      "        arr[j + 1] = key;",
      "    }",
      "}"
    ],
    "description": "Insertion Sort maintaining a sorted 0-indexed prefix; highly efficient on small or nearly sorted arrays."
