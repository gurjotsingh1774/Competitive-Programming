    "body": [
      "// Merges two sorted 0-indexed subarrays arr[l..m] and arr[m+1..r]; O(r - l)",
      "void merge(vector<int>& arr, int l, int m, int r) {",
      "    int n1 = m - l + 1, n2 = r - m;",
      "    vector<int> L(n1), R(n2);",
      "    for (int i = 0; i < n1; i++) L[i] = arr[l + i];",
      "    for (int j = 0; j < n2; j++) R[j] = arr[m + 1 + j];",
      "    int i = 0, j = 0, k = l;",
      "    while (i < n1 && j < n2) {",
      "        if (L[i] <= R[j]) arr[k++] = L[i++];",
      "        else arr[k++] = R[j++];",
      "    }",
      "    while (i < n1) arr[k++] = L[i++];",
      "    while (j < n2) arr[k++] = R[j++];",
      "}",
      "",
      "// Sorts 0-indexed subarray arr[l..r] using Merge Sort; guaranteed O(n log n)",
      "void mergeSort(vector<int>& arr, int l, int r) {",
      "    if (l < r) {",
      "        int m = l + (r - l) / 2;",
      "        mergeSort(arr, l, m);",
      "        mergeSort(arr, m + 1, r);",
      "        merge(arr, l, m, r);",
      "    }",
      "}"
    ],
    "description": "Stable Merge Sort on 0-indexed ranges [l, r] with guaranteed O(n log n) runtime."
  },
