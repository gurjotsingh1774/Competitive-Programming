    "body": [
      "#include<iostream>",
      "#include<algorithm>",
      "",
      "long long nCr(int n, int r) {",
      "    if (r < 0 || r > n) return 0;",
      "    if (r > n - r) r = n - r; // Symmetry optimization C(n, r) = C(n, n - r)",
      "",
      "    long long res = 1;",
      "    for (int i = 0; i < r; ++i) {",
      "        res = res * (n - i);",
      "        res /= (i + 1);",
      "    }",
      "    return res;",
      "}"
    ],
    "description": "Computes \\binom{n}{r} = \\frac{n(n-1)\u00b7s(n-r+1)}{r!} iteratively without overflow up to 64-bit limits."
