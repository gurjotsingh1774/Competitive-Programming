      "        for (auto [v, w] : g[u])",
      "            if (du + w < d[v]) {",
      "                d[v] = du + w, pq.push({d[v], v});",
      "                if (parent) (*parent)[v] = u;",
      "            }",
      "    }",
      "    return d;",
      "}",
      "",
      "// Reconstructs path from s to t (empty vector if t is unreachable).",
