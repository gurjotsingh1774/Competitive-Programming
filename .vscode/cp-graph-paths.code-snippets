      "    vector<int> p;",
      "    for (int v = t; v != -1; v = parent[v]) {",
      "        p.push_back(v);",
      "        if (v == s) break;",
      "    }",
      "    reverse(p.begin(), p.end());",
      "    return (p.empty() || p[0] != s) ? vector<int>() : p;",
      "}"
