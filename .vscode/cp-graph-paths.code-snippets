      "inline bool bellman_ford(int n, const vector<array<ll, 3>> &edges, int s, vector<ll> &d) {",
      "    d.assign(n, SP_INF), d[s] = 0;",
      "    for (int it = 0; it < n; it++) {",
      "        bool ch = false;",
      "        for (auto [u, v, w] : edges)",
      "            if (d[u] < SP_INF && d[u] + w < d[v]) {",
      "                d[v] = d[u] + w, ch = true;",
      "                if (it == n - 1) return true;",
      "            }",
      "        if (!ch) break;",
      "    }",
      "    return false;",
      "}"
    ],
