  "Fast Hash Table (PBDS gp_hash_table with chash)": {
    "prefix": [
      "cp-fast-hash-table",
      "cp-fast-map",
      "cp-gp-hash-table"
    ],
    "body": [
      "#include <cmath>",
      "#include <cstdint>",
      "#include <ext/pb_ds/assoc_container.hpp>",
      "",
      "// Anti-hash-collision custom 64-bit integer hash using odd irrational constant multiplier",
      "struct chash {",
      "    const uint64_t C = (uint64_t)(4e18 * acos(0)) | 71;  // Random odd multiplier based on pi",
      "    // 0-indexed byte-swap reversal after multiplication to defeat anti-hash tests",
      "    uint64_t operator()(uint64_t x) const { return __builtin_bswap64(x * C); }",
      "};",
      "",
      "// Ultra-fast hash table wrapping GCC PBDS gp_hash_table with chash and preallocated bucket power-of-2 size",
      "template <class K, class V, class Hash = chash>",
      "struct fast_hash_table : public __gnu_pbds::gp_hash_table<K, V, Hash> {",
      "    using Base = __gnu_pbds::gp_hash_table<K, V, Hash>;",
      "    // Constructor: preallocates initial_capacity buckets (default: 2^16 = 65536) to prevent rehashing overhead",
      "    fast_hash_table(size_t initial_capacity = (1 << 16))",
      "        : Base({}, {}, {}, {}, {initial_capacity}) {}",
      "};",
      "",
      "// Ultra-fast hash set wrapping GCC PBDS gp_hash_table with null_type",
      "template <class K, class Hash = chash>",
      "struct fast_hash_set : public __gnu_pbds::gp_hash_table<K, __gnu_pbds::null_type, Hash> {",
      "    using Base = __gnu_pbds::gp_hash_table<K, __gnu_pbds::null_type, Hash>;",
      "    // Constructor: preallocates initial_capacity buckets (default: 2^16 = 65536)",
      "    fast_hash_set(size_t initial_capacity = (1 << 16))",
      "        : Base({}, {}, {}, {}, {initial_capacity}) {}",
      "};"
    ],
    "description": "Ultra-fast GCC PBDS gp_hash_table with anti-hack chash and preallocated buckets (3-6x faster than std::unordered_map)."
  },
