  "Hash Table with Separate Chaining": {
    "prefix": [
      "cp-hash-table",
      "cp-custom-hash-table"
    ],
    "body": [
      "#include<vector>",
      "#include<list>",
      "#include<utility>",
      "#include<stdexcept>",
      "",
      "template <typename K, typename V>",
      "class ChainingHashTable {",
      "private:",
      "    std::vector<std::list<std::pair<K, V>>> table;  // Array of buckets storing key-value pairs",
      "    size_t num_elements = 0;                         // Total number of stored elements",
      "    size_t num_buckets;                              // Total number of hash buckets",
      "",
      "    // 0-indexed bucket hash computation",
      "    size_t hash(const K& key) const {",
      "        return std::hash<K>{}(key) % num_buckets;",
      "    }",
      "",
      "public:",
      "    // Initializes hash table with specified number of buckets (default 101)",
      "    ChainingHashTable(size_t buckets = 101) : num_buckets(buckets), table(buckets) {}",
      "",
      "    // Inserts or updates key-value pair; expected O(1)",
      "    void insert(const K& key, const V& value) {",
      "        size_t b = hash(key);",
      "        for (auto& pair : table[b]) {",
      "            if (pair.first == key) {",
      "                pair.second = value; // Update existing",
      "                return;",
      "            }",
      "        }",
      "        table[b].emplace_back(key, value);",
      "        num_elements++;",
      "    }",
      "",
      "    // Finds value for key; returns true and sets out_val if found; expected O(1)",
      "    bool find(const K& key, V& out_val) const {",
      "        size_t b = hash(key);",
      "        for (const auto& pair : table[b]) {",
      "            if (pair.first == key) {",
      "                out_val = pair.second;",
      "                return true;",
      "            }",
      "        }",
      "        return false;",
      "    }",
      "",
      "    // Erases key from table; returns true if removed, false otherwise; expected O(1)",
      "    bool erase(const K& key) {",
      "        size_t b = hash(key);",
      "        for (auto it = table[b].begin(); it != table[b].end(); ++it) {",
      "            if (it->first == key) {",
      "                table[b].erase(it);",
      "                num_elements--;",
      "                return true;",
      "            }",
      "        }",
      "        return false;",
      "    }",
      "",
      "    // Number of elements in table",
      "    size_t size() const { return num_elements; }",
      "",
      "    // Checks if table has 0 elements",
      "    bool empty() const { return num_elements == 0; }",
      "};"
    ],
    "description": "Hash Table with Separate Chaining for key-value storage with expected O(1) operations."
  },
  "Anti-Hack Custom Hash for Competitive Programming": {
    "prefix": [
      "cp-custom-hash",
      "cp-anti-hack-hash"
    ],
    "body": [
      "#include<chrono>",
      "#include<cstdint>",
      "#include<unordered_map>",
      "",
      "// High-performance anti-hack custom 64-bit hash (prevents O(N^2) HashDOS hacks on Codeforces)",
      "struct custom_hash {",
      "    static uint64_t splitmix64(uint64_t x) {",
      "        // http://xorshift.di.unimi.it/splitmix64.c",
      "        x += 0x9e3779b97f4a7c15;",
      "        x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9;",
      "        x = (x ^ (x >> 27)) * 0x94d049bb133111eb;",
      "        return x ^ (x >> 31);",
      "    }",
      "",
      "    size_t operator()(uint64_t x) const {",
      "        static const uint64_t FIXED_RANDOM =",
      "            std::chrono::steady_clock::now().time_since_epoch().count();",
      "        return splitmix64(x + FIXED_RANDOM);",
      "    }",
      "};",
      "",
      "// Safe hash table declarations in CP:",
      "// std::unordered_map<long long, int, custom_hash> safe_map;",
      "// std::unordered_set<long long, custom_hash> safe_set;"
    ],
    "description": "Anti-hack custom hash using splitmix64 with randomized timestamp seed to prevent O(n^2) hash-collision tests."
  },
