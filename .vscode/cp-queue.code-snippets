  "Circular Buffer Queue": {
    "prefix": [
      "cp-circular-queue",
      "cp-queue-circular"
    ],
    "body": [
      "#include<vector>",
      "#include<stdexcept>",
      "",
      "template <typename T>",
      "class CircularQueue {",
      "private:",
      "    std::vector<T> buffer;  // Fixed ring buffer array",
      "    int head = 0;           // 0-indexed read pointer",
      "    int tail = 0;           // 0-indexed write pointer",
      "    int count = 0;          // Current number of elements stored",
      "    int capacity;           // Maximum capacity of queue",
      "",
      "public:",
      "    // Initializes circular buffer with fixed capacity cap",
      "    CircularQueue(int cap) : buffer(cap), capacity(cap) {}",
      "",
      "    // Pushes value to back; returns false if full; O(1)",
      "    bool push(T val) {",
      "        if (count == capacity) return false; // Full",
      "        buffer[tail] = val;",
      "        tail = (tail + 1) % capacity;        // Advances 0-indexed tail cyclically",
      "        count++;",
      "        return true;",
      "    }",
      "",
      "    // Pops value from front; returns false if empty; O(1)",
      "    bool pop() {",
      "        if (count == 0) return false;        // Empty",
      "        head = (head + 1) % capacity;        // Advances 0-indexed head cyclically",
      "        count--;",
      "        return true;",
      "    }",
      "",
      "    // Returns front element; throws if empty; O(1)",
      "    T front() const {",
      "        if (count == 0) throw std::out_of_range(\"Queue is empty\");",
      "        return buffer[head];",
      "    }",
      "",
      "    // Checks if queue contains 0 elements",
      "    bool empty() const { return count == 0; }",
      "",
      "    // Checks if queue is at maximum capacity",
      "    bool full() const { return count == capacity; }",
      "",
      "    // Number of elements currently stored",
      "    int size() const { return count; }",
      "};"
    ],
    "description": "FIFO fixed-size ring buffer queue avoiding dynamic reallocation overhead."
  },
  "Circular Array Deque": {
    "prefix": [
      "cp-array-deque",
      "cp-deque-circular"
    ],
    "body": [
      "#include<vector>",
      "#include<stdexcept>",
      "",
      "template <typename T>",
      "class ArrayDeque {",
      "private:",
      "    std::vector<T> buf;  // Circular ring buffer array",
      "    int front_idx = 0;   // 0-indexed front element pointer",
      "    int rear_idx = 0;    // 0-indexed rear element pointer",
      "    int count = 0;       // Current number of elements stored",
      "    int cap;             // Maximum capacity",
      "",
      "public:",
      "    // Initializes circular deque with fixed capacity",
      "    ArrayDeque(int capacity) : buf(capacity), cap(capacity), rear_idx(capacity - 1) {}",
      "",
      "    // Inserts value at front; returns false if full; O(1)",
      "    bool push_front(T val) {",
      "        if (count == cap) return false;",
      "        front_idx = (front_idx - 1 + cap) % cap;  // Moves 0-indexed front backward",
      "        buf[front_idx] = val;",
      "        count++;",
      "        return true;",
      "    }",
      "",
      "    // Inserts value at back; returns false if full; O(1)",
      "    bool push_back(T val) {",
      "        if (count == cap) return false;",
      "        rear_idx = (rear_idx + 1) % cap;          // Moves 0-indexed rear forward",
      "        buf[rear_idx] = val;",
      "        count++;",
      "        return true;",
      "    }",
      "",
      "    // Removes front element; returns false if empty; O(1)",
      "    bool pop_front() {",
      "        if (count == 0) return false;",
      "        front_idx = (front_idx + 1) % cap;",
      "        count--;",
      "        return true;",
      "    }",
      "",
      "    // Removes back element; returns false if empty; O(1)",
      "    bool pop_back() {",
      "        if (count == 0) return false;",
      "        rear_idx = (rear_idx - 1 + cap) % cap;",
      "        count--;",
      "        return true;",
      "    }",
      "",
      "    // Returns front element; throws if empty; O(1)",
      "    T front() const {",
      "        if (count == 0) throw std::out_of_range(\"Deque empty\");",
      "        return buf[front_idx];",
      "    }",
      "",
      "    // Returns back element; throws if empty; O(1)",
      "    T back() const {",
      "        if (count == 0) throw std::out_of_range(\"Deque empty\");",
      "        return buf[rear_idx];",
      "    }",
      "",
      "    // Checks if deque contains 0 elements",
      "    bool empty() const { return count == 0; }",
      "",
      "    // Number of elements in deque",
      "    int size() const { return count; }",
      "};"
    ],
    "description": "Double-Ended Queue on circular ring buffer with O(1) operations at both ends."
  }
