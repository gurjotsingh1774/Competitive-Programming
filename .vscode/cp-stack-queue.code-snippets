      "#include<stdexcept>",
      "",
      "template <typename T>",
      "class ArrayStack {",
      "private:",
      "    std::vector<T> data;",
      "",
      "public:",
      "    void push(T val) {",
      "        data.push_back(val);",
      "    }",
      "",
      "    void pop() {",
      "        if (data.empty()) throw std::out_of_range(\"Stack underflow\");",
      "        data.pop_back();",
      "    }",
      "",
      "    T top() const {",
      "        if (data.empty()) throw std::out_of_range(\"Stack is empty\");",
      "        return data.back();",
      "    }",
      "",
      "    bool empty() const { return data.empty(); }",
      "    size_t size() const { return data.size(); }",
      "    void clear() { data.clear(); }",
