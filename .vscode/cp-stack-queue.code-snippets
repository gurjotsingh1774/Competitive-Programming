    "body": [
      "#include<vector>",
      "#include<stdexcept>",
      "",
      "template <typename T>",
      "class CircularQueue {",
      "private:",
      "    std::vector<T> buffer;",
      "    int head = 0;",
      "    int tail = 0;",
      "    int count = 0;",
      "    int capacity;",
      "",
      "public:",
      "    CircularQueue(int cap) : buffer(cap), capacity(cap) {}",
      "",
      "    bool push(T val) {",
      "        if (count == capacity) return false; // Full",
      "        buffer[tail] = val;",
      "        tail = (tail + 1) % capacity;",
      "        count++;",
      "        return true;",
      "    }",
      "",
      "    bool pop() {",
      "        if (count == 0) return false; // Empty",
      "        head = (head + 1) % capacity;",
      "        count--;",
      "        return true;",
      "    }",
      "",
      "    T front() const {",
      "        if (count == 0) throw std::out_of_range(\"Queue is empty\");",
      "        return buffer[head];",
      "    }",
      "",
      "    bool empty() const { return count == 0; }",
      "    bool full() const { return count == capacity; }",
      "    int size() const { return count; }",
      "};"
    ],
    "description": "A FIFO (First-In-First-Out) ring buffer avoiding dynamic memory reallocation during operations."
  },
