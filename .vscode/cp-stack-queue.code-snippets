      "int getPrecedence(char op) {",
      "    if (op == '^') return 3;",
      "    if (op == '*' || op == '/' || op == '%') return 2;",
      "    if (op == '+' || op == '-') return 1;",
      "    return 0;",
      "}",
      "",
      "bool isRightAssociative(char op) {",
      "    return op == '^';",
      "}",
      "",
      "std::string infixToPostfix(const std::string& expr) {",
      "    std::stack<char> s;",
      "    std::string postfix;",
      "",
      "    for (char c : expr) {",
      "        if (std::isspace(c)) continue;",
      "",
      "        if (std::isalnum(c)) {",
      "            postfix += c;",
      "        } else if (c == '(') {",
      "            s.push(c);",
      "        } else if (c == ')') {",
      "            while (!s.empty() && s.top() != '(') {",
      "                postfix += s.top();",
      "                s.pop();",
      "            }",
      "            if (!s.empty()) s.pop(); // Pop '('",
      "        } else {",
      "            // Operator",
      "            while (!s.empty() && s.top() != '(' &&",
      "                   (getPrecedence(s.top()) > getPrecedence(c) ||",
      "                    (getPrecedence(s.top()) == getPrecedence(c) && !isRightAssociative(c)))) {",
      "                postfix += s.top();",
      "                s.pop();",
      "            }",
      "            s.push(c);",
      "        }",
      "    }",
      "",
      "    while (!s.empty()) {",
      "        postfix += s.top();",
      "        s.pop();",
      "    }",
      "    return postfix;",
      "}"
