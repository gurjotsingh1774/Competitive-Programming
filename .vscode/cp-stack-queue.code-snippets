      "",
      "template <typename T>",
      "class ArrayDeque {",
      "private:",
      "    std::vector<T> buf;",
      "    int front_idx = 0;",
      "    int rear_idx = 0;",
      "    int count = 0;",
      "    int cap;",
      "",
      "public:",
      "    ArrayDeque(int capacity) : buf(capacity), cap(capacity), rear_idx(capacity - 1) {}",
      "",
      "    bool push_front(T val) {",
      "        if (count == cap) return false;",
      "        front_idx = (front_idx - 1 + cap) % cap;",
      "        buf[front_idx] = val;",
      "        count++;",
      "        return true;",
      "    }",
      "",
      "    bool push_back(T val) {",
      "        if (count == cap) return false;",
      "        rear_idx = (rear_idx + 1) % cap;",
      "        buf[rear_idx] = val;",
      "        count++;",
      "        return true;",
      "    }",
      "",
      "    bool pop_front() {",
      "        if (count == 0) return false;",
      "        front_idx = (front_idx + 1) % cap;",
      "        count--;",
      "        return true;",
      "    }",
      "",
      "    bool pop_back() {",
      "        if (count == 0) return false;",
      "        rear_idx = (rear_idx - 1 + cap) % cap;",
      "        count--;",
      "        return true;",
      "    }",
      "",
      "    T front() const {",
      "        if (count == 0) throw std::out_of_range(\"Deque empty\");",
      "        return buf[front_idx];",
      "    }",
      "",
      "    T back() const {",
      "        if (count == 0) throw std::out_of_range(\"Deque empty\");",
      "        return buf[rear_idx];",
      "    }",
      "",
      "    bool empty() const { return count == 0; }",
      "    int size() const { return count; }",
      "};"
    ],
    "description": "Allows fast O(1) insertion and deletion at both ends."
