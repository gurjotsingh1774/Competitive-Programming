      "    vector<int> dep;",
      "    LCA(const vector<vector<int>> &g = {}, int root = 0) : n(g.size()), dep(g.size(), 0) {",
      "        LOG = 1;",
      "        while ((1 << LOG) < n) LOG++;",
      "        up.assign(LOG, vector<int>(n, root));",
      "        vector<char> seen(n, 0);",
      "        vector<int> q = {root};",
      "        seen[root] = 1;",
      "        for (size_t i = 0; i < q.size(); i++) {",
      "            int u = q[i];",
      "            for (int v : g[u]) if (!seen[v]) seen[v] = 1, dep[v] = dep[u] + 1, up[0][v] = u, q.push_back(v);",
      "        }",
      "        for (int j = 1; j < LOG; j++)",
      "            for (int v = 0; v < n; v++) up[j][v] = up[j - 1][up[j - 1][v]];",
      "    }",
      "    int kth(int v, int k) const {",
      "        for (int j = 0; j < LOG; j++) if (k >> j & 1) v = up[j][v];",
      "        return v;",
      "    }",
      "    int lca(int a, int b) const {",
      "        if (dep[a] < dep[b]) swap(a, b);",
      "        a = kth(a, dep[a] - dep[b]);",
      "        if (a == b) return a;",
      "        for (int j = LOG - 1; j >= 0; j--)",
      "            if (up[j][a] != up[j][b]) a = up[j][a], b = up[j][b];",
      "        return up[0][a];",
      "    }",
      "    int dist(int a, int b) const { return dep[a] + dep[b] - 2 * dep[lca(a, b)]; }",
      "};"
