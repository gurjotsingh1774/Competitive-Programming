      "ll boruvka(int n, const vector<tuple<ll, int, int>>& edges) {",
      "    DSU d(n);",
      "    int numComps = n;",
      "    ll totalWeight = 0;",
      "",
      "    while (numComps > 1) {",
      "        vector<int> cheapest(n, -1);",
      "        for (int i = 0; i < (int)edges.size(); i++) {",
      "            auto [w, u, v] = edges[i];",
      "            int rootU = d.find(u), rootV = d.find(v);",
      "            if (rootU == rootV) continue;",
      "",
      "            if (cheapest[rootU] == -1 || get<0>(edges[cheapest[rootU]]) > w) cheapest[rootU] = i;",
      "            if (cheapest[rootV] == -1 || get<0>(edges[cheapest[rootV]]) > w) cheapest[rootV] = i;",
      "        }",
      "",
      "        bool progress = false;",
      "        for (int i = 0; i < n; i++) {",
      "            if (cheapest[i] != -1) {",
      "                auto [w, u, v] = edges[cheapest[i]];",
      "                if (d.unite(u, v)) {",
      "                    totalWeight += w;",
      "                    numComps--;",
      "                    progress = true;",
      "                }",
      "            }",
      "        }",
      "        if (!progress) break; // Graph is disconnected",
      "    }",
      "    return totalWeight;",
      "}"
