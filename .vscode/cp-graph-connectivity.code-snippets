      "                if (comp[u] != comp[v]) dag[comp[u]].push_back(comp[v]);",
      "        for (auto &a : dag) {",
      "            sort(a.begin(), a.end());",
      "            a.erase(unique(a.begin(), a.end()), a.end());",
      "        }",
      "        return dag;",
      "    }",
      "};"
