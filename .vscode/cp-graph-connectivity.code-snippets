      "    }",
      "    void add_imply(int i, bool a, int j, bool b) { add_or(i, !a, j, b); }",
      "    void set_value(int i, bool a) { add_or(i, a, i, a); }",
      "    bool solve() {",
      "        scc.build();",
      "        for (int i = 0; i < n; i++) {",
      "            if (scc.comp[2 * i] == scc.comp[2 * i + 1]) return false;",
