      "struct SCC {",
      "    int n, ncomp = 0;",
      "    vector<vector<int>> g;",
      "    vector<int> comp;",
      "    SCC(int n_ = 0) : n(n_), g(n_) {}",
      "    void add_edge(int u, int v) { g[u].push_back(v); }",
      "    void build() {",
      "        comp.assign(n, -1);",
      "        vector<int> low(n, 0), num(n, -1), it(n, 0), st, call;",
      "        vector<char> onst(n, 0);",
      "        int timer = 0;",
      "        ncomp = 0;",
      "        for (int s = 0; s < n; s++) {",
      "            if (num[s] >= 0) continue;",
      "            num[s] = low[s] = timer++, st.push_back(s), onst[s] = 1, call.push_back(s);",
      "            while (!call.empty()) {",
      "                int v = call.back();",
      "                if (it[v] < (int)g[v].size()) {",
      "                    int w = g[v][it[v]++];",
      "                    if (num[w] < 0) num[w] = low[w] = timer++, st.push_back(w), onst[w] = 1, call.push_back(w);",
      "                    else if (onst[w]) low[v] = min(low[v], num[w]);",
      "                } else {",
      "                    if (low[v] == num[v]) {",
      "                        while (true) {",
      "                            int w = st.back();",
      "                            st.pop_back(), onst[w] = 0, comp[w] = ncomp;",
      "                            if (w == v) break;",
      "                        }",
      "                        ncomp++;",
      "                    }",
      "                    call.pop_back();",
      "                    if (!call.empty()) low[call.back()] = min(low[call.back()], low[v]);",
      "                }",
      "            }",
      "        }",
      "    }",
      "    vector<vector<int>> groups() const {",
      "        vector<vector<int>> r(ncomp);",
      "        for (int v = 0; v < n; v++) r[comp[v]].push_back(v);",
      "        return r;",
      "    }",
      "    vector<vector<int>> condensation() const {",
      "        vector<vector<int>> dag(ncomp);",
      "        for (int u = 0; u < n; u++)",
