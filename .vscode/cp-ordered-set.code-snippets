{
  "OrderedTree (Treap-based Portable Ordered Set & Multiset)": {
    "prefix": [
      "cp-ordered-tree",
      "cp-portable-ordered-set",
      "cp-treap-ost",
      "cp-ost",
      "cp-ordered-set-treap",
      "cp-ordered-set",
      "cp-ordered-multiset"
    ],
    "body": [
      "// Portable order-statistic tree (randomized treap with subtree sizes).",
      "// Works on any C++17 compiler: GCC, Clang, MSVC. No pb_ds needed.",
      "//",
      "// The comparator decides the behavior, exactly like pb_ds:",
      "//   Cmp = less<T>        -> set      (unique keys)",
      "//   Cmp = less_equal<T>  -> multiset (duplicates allowed)",
      "// (greater<T> / greater_equal<T> give descending versions.)",
      "// All operations are expected O(log n).",
      "template <class T, class Cmp = less<T>>",
      "class OrderedTree {",
      "    struct Node {",
      "        T key;          // Element value stored in this node",
      "        unsigned pri;   // Random heap priority for balanced tree height",
      "        int l;          // Left child index in t, 1-indexed (0 = null)",
      "        int r;          // Right child index in t, 1-indexed (0 = null)",
      "        int sz;         // Subtree size count",
      "    };",
      "    vector<Node> t;     // Node storage: t[0] is null/sentinel (sz = 0), active nodes are 1-indexed",
      "    vector<int> freed;  // Recycled node IDs for memory reuse",
      "    int root = 0;       // Root node index in t, 1-indexed (0 = empty tree)",
      "    Cmp cmp;            // Base comparator object",
      "    bool allowDup;      // True for multiset (duplicates allowed), false for unique set",
      "    mt19937 rng;        // 32-bit Mersenne Twister RNG for random node priorities",
      "",
      "    // Strict \"a < b\" built from Cmp. Correct for both less and less_equal:",
      "    //   less:       a<b  && !(b<a)   == a<b",
      "    //   less_equal: a<=b && !(b<=a)  == a<b",
      "    // This is why erase/find/bounds are NOT broken for the multiset here.",
      "    bool lt(const T& a, const T& b) const { return cmp(a, b) && !cmp(b, a); }",
      "",
      "    // Subtree size of node v, 1-indexed (returns 0 for v = 0 / null node)",
      "    int sz(int v) const { return t[v].sz; }",
      "",
      "    // Recomputes subtree size of node v from its left and right children",
      "    void pull(int v) { t[v].sz = sz(t[v].l) + sz(t[v].r) + 1; }",
      "",
      "    // Allocates a new node with key k and random priority, returning 1-indexed node ID",
      "    int newNode(const T& k) {",
      "        Node nd{k, (unsigned)rng(), 0, 0, 1};",
      "        if (!freed.empty()) {",
      "            int id = freed.back();",
      "            freed.pop_back();",
      "            t[id] = nd;",
      "            return id;",
      "        }",
      "        t.push_back(nd);",
      "        return (int)t.size() - 1;",
      "    }",
      "",
      "    // Recycles whole subtree rooted at 1-indexed node v into freed pool",
      "    void release(int v) {",
      "        if (!v) return;",
      "        release(t[v].l);",
      "        release(t[v].r);",
      "        freed.push_back(v);",
      "    }",
      "",
      "    // Splits subtree v into a (keys < k) and b (keys >= k)",
      "    void splitLess(int v, const T& k, int& a, int& b) {",
      "        if (!v) { a = b = 0; return; }",
      "        if (lt(t[v].key, k)) {",
      "            a = v;",
      "            splitLess(t[v].r, k, t[v].r, b);",
      "        } else {",
      "            b = v;",
      "            splitLess(t[v].l, k, a, t[v].l);",
      "        }",
      "        pull(v);",
      "    }",
      "",
      "    // Splits subtree v into a (keys <= k) and b (keys > k)",
      "    void splitLeq(int v, const T& k, int& a, int& b) {",
      "        if (!v) { a = b = 0; return; }",
      "        if (!lt(k, t[v].key)) {",
      "            a = v;",
      "            splitLeq(t[v].r, k, t[v].r, b);",
      "        } else {",
      "            b = v;",
      "            splitLeq(t[v].l, k, a, t[v].l);",
      "        }",
      "        pull(v);",
      "    }",
      "",
      "    // Merges subtrees a and b (requires all keys in a <= all keys in b)",
      "    int merge(int a, int b) {",
      "        if (!a) return b;",
      "        if (!b) return a;",
      "        if (t[a].pri > t[b].pri) {",
      "            t[a].r = merge(t[a].r, b);",
      "            pull(a);",
      "            return a;",
      "        }",
      "        t[b].l = merge(a, t[b].l);",
      "        pull(b);",
      "        return b;",
      "    }",
      "",
      "    // In-order traversal of subtree v into 0-indexed output vector out",
      "    void collect(int v, vector<T>& out) const {",
      "        if (!v) return;",
      "        collect(t[v].l, out);",
      "        out.push_back(t[v].key);",
      "        collect(t[v].r, out);",
      "    }",
      "",
      "public:",
      "    // Default constructor: initializes empty tree with sentinel node t[0]",
      "    OrderedTree() : rng(chrono::steady_clock::now().time_since_epoch().count()) {",
      "        t.push_back(Node{T(), 0, 0, 0, 0});",
      "        allowDup = cmp(t[0].key, t[0].key);",
      "    }",
      "",
      "    // Total number of elements in tree",
      "    int size() const { return sz(root); }",
      "",
      "    // Checks if tree is empty (contains 0 elements)",
      "    bool empty() const { return root == 0; }",
      "",
      "    // Pre-allocates node capacity for n elements",
      "    void reserve(int n) { t.reserve(n + 1); }",
      "",
      "    // Clears all elements, resets to empty tree",
      "    void clear() { t.resize(1); freed.clear(); root = 0; }",
      "",
      "    // Checks if key x is present; returns true if found, false otherwise (O(log n))",
      "    bool contains(const T& x) const {",
      "        int v = root;",
      "        while (v) {",
      "            if (lt(x, t[v].key)) v = t[v].l;",
      "            else if (lt(t[v].key, x)) v = t[v].r;",
      "            else return true;",
      "        }",
      "        return false;",
      "    }",
      "",
      "    // Inserts key x. For unique set, returns false (and does nothing) if x already exists; O(log n)",
      "    bool insert(const T& x) {",
      "        if (!allowDup && contains(x)) return false;",
      "        int a, b;",
      "        splitLess(root, x, a, b);",
      "        root = merge(merge(a, newNode(x)), b);",
      "        return true;",
      "    }",
      "",
      "    // Erases ONE copy of key x. Returns true if removed, false if not present; O(log n)",
      "    bool erase(const T& x) {",
      "        int a, b, m, c;",
      "        splitLess(root, x, a, b);",
      "        splitLeq(b, x, m, c);",
      "        bool found = (m != 0);",
      "        if (found) {",
      "            int rest = merge(t[m].l, t[m].r);  // drop the root of the equal block",
      "            freed.push_back(m);",
      "            m = rest;",
      "        }",
      "        root = merge(a, merge(m, c));",
      "        return found;",
      "    }",
      "",
      "    // Erases ALL copies of key x. Returns number of removed elements; O(log n)",
      "    int eraseAll(const T& x) {",
      "        int a, b, m, c;",
      "        splitLess(root, x, a, b);",
      "        splitLeq(b, x, m, c);",
      "        int cnt = sz(m);",
      "        release(m);",
      "        root = merge(a, c);",
      "        return cnt;",
      "    }",
      "",
      "    // 0-indexed rank: number of elements strictly less than x (< x); O(log n)",
      "    int order_of_key(const T& x) const {",
      "        int v = root, res = 0;",
      "        while (v) {",
      "            if (lt(t[v].key, x)) { res += sz(t[v].l) + 1; v = t[v].r; }",
      "            else v = t[v].l;",
      "        }",
      "        return res;",
      "    }",
      "",
      "    // Number of elements less than or equal to x (<= x); O(log n)",
      "    int count_leq(const T& x) const {",
      "        int v = root, res = 0;",
      "        while (v) {",
      "            if (!lt(x, t[v].key)) { res += sz(t[v].l) + 1; v = t[v].r; }",
      "            else v = t[v].l;",
      "        }",
      "        return res;",
      "    }",
      "",
      "    // Number of occurrences of key x; O(log n)",
      "    int count(const T& x) const { return count_leq(x) - order_of_key(x); }",
      "",
      "    // k-th smallest element, 0-indexed. Requires 0 <= k < size(); O(log n)",
      "    const T& find_by_order(int k) const {",
      "        assert(0 <= k && k < size());",
      "        int v = root;",
      "        while (true) {",
      "            int L = sz(t[v].l);",
      "            if (k < L) v = t[v].l;",
      "            else if (k == L) return t[v].key;",
      "            else { k -= L + 1; v = t[v].r; }",
      "        }",
      "    }",
      "",
      "    // Smallest element >= x (0-indexed lower bound), or nullopt if none; O(log n)",
      "    optional<T> lower_bound(const T& x) const {",
      "        int i = order_of_key(x);",
      "        if (i == size()) return nullopt;",
      "        return find_by_order(i);",
      "    }",
      "",
      "    // Smallest element > x (0-indexed upper bound), or nullopt if none; O(log n)",
      "    optional<T> upper_bound(const T& x) const {",
      "        int i = count_leq(x);",
      "        if (i == size()) return nullopt;",
      "        return find_by_order(i);",
      "    }",
      "",
      "    // Exports all elements in sorted order into a 0-indexed std::vector; O(n)",
      "    vector<T> to_vector() const {",
      "        vector<T> out;",
      "        out.reserve(size());",
      "        collect(root, out);",
      "        return out;",
      "    }",
      "};",
      "",
      "// Type aliases for standard ordered set and multiset",
      "template <class T>",
      "using ordered_set = OrderedTree<T, less<T>>;",
      "",
      "template <class T>",
      "using ordered_multiset = OrderedTree<T, less_equal<T>>;"
    ],
    "description": "Portable order-statistic tree (randomized Treap with subtree sizes). Works on any C++17 compiler (GCC, Clang, MSVC) without PBDS. Expected O(log n) order_of_key, find_by_order, lower_bound, upper_bound, count, insert, and erase."
  },
  "OrderedSet: Instantiate (Ascending)": {
    "prefix": [
      "cp-os-init",
      "cp-ordered-set-init"
    ],
    "body": [
      "ordered_set<${1:int}> ${2:s};  // Unique keys, ascending order",
      "// ${2}.insert(x); ${2}.erase(x); ${2}.order_of_key(x) [0-indexed rank]; ${2}.find_by_order(k) [0-indexed]; ${2}.lower_bound(x);"
    ],
    "description": "Instantiate a portable ordered_set (unique elements, ascending order)."
  },
  "OrderedMultiset: Instantiate (Ascending)": {
    "prefix": [
      "cp-oms-init",
      "cp-ordered-multiset-init"
    ],
    "body": [
      "ordered_multiset<${1:int}> ${2:ms};  // Duplicates allowed, ascending order",
      "// ${2}.insert(x); ${2}.erase(x); // erases ONE copy safely",
      "// ${2}.eraseAll(x); ${2}.count(x); ${2}.order_of_key(x) [0-indexed rank]; ${2}.find_by_order(k) [0-indexed];"
    ],
    "description": "Instantiate a portable ordered_multiset (duplicates allowed, ascending order; erase(x) removes ONE copy safely)."
  },
  "OrderedSet: Instantiate (Descending)": {
    "prefix": [
      "cp-os-desc-init",
      "cp-ordered-set-desc"
    ],
    "body": [
      "OrderedTree<${1:int}, greater<${1:int}>> ${2:s_desc};  // Unique keys, descending order",
      "// ${2}.insert(x); ${2}.erase(x); ${2}.order_of_key(x) [0-indexed rank]; ${2}.find_by_order(k) [0-indexed];"
    ],
    "description": "Instantiate a portable ordered_set with descending order (greater<T>)."
  },
  "OrderedMultiset: Instantiate (Descending)": {
    "prefix": [
      "cp-oms-desc-init",
      "cp-ordered-multiset-desc"
    ],
    "body": [
      "OrderedTree<${1:int}, greater_equal<${1:int}>> ${2:ms_desc};  // Duplicates allowed, descending order",
      "// ${2}.insert(x); ${2}.erase(x); // erases ONE copy safely",
      "// ${2}.eraseAll(x); ${2}.count(x); ${2}.order_of_key(x) [0-indexed rank]; ${2}.find_by_order(k) [0-indexed];"
    ],
    "description": "Instantiate a portable ordered_multiset with descending order (greater_equal<T>)."
  },
  "OrderedSet: Pair / Custom Key": {
    "prefix": [
      "cp-os-pair-init",
      "cp-ordered-set-pair"
    ],
    "body": [
      "ordered_set<pair<${1:int}, ${2:int}>> ${3:s_pair};  // (value, id) for distinct indexing",
      "// ${3}.insert({${4:val}, ${5:id}}); ${3}.order_of_key({${6:x}, -1}) [0-indexed count < x];"
    ],
    "description": "Instantiate a portable ordered_set of pairs for distinct (value, id) indexing."
  },
  "OrderedTree: Rank (order_of_key)": {
    "prefix": [
      "cp-ost-order",
      "cp-order-of-key"
    ],
    "body": [
      "${1:s}.order_of_key(${2:x})  // 0-indexed rank: count of elements strictly < x"
    ],
    "description": "Count number of elements strictly smaller than x in O(log n)."
  },
  "OrderedTree: k-th Element (find_by_order)": {
    "prefix": [
      "cp-ost-kth",
      "cp-find-by-order"
    ],
    "body": [
      "${1:s}.find_by_order(${2:k})  // k-th smallest element, 0-indexed. Requires 0 <= k < ${1:s}.size()"
    ],
    "description": "Query k-th smallest element (0-indexed) in O(log n)."
  },
  "OrderedTree: Lower Bound Query": {
    "prefix": [
      "cp-ost-lb",
      "cp-ost-lower-bound"
    ],
    "body": [
      "if (auto ${1:opt} = ${2:s}.lower_bound(${3:x}); ${1:opt}) {  // Smallest element >= x (0-indexed lookup)",
      "    ${4:auto val = *${1:opt};}",
      "}"
    ],
    "description": "Smallest element >= x as optional<T> (or nullopt if none) in O(log n)."
  },
  "OrderedTree: Upper Bound Query": {
