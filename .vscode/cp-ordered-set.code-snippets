    ],
    "body": [
      "if (auto ${1:opt} = ${2:s}.upper_bound(${3:x}); ${1:opt}) {  // Smallest element > x (0-indexed lookup)",
      "    ${4:auto val = *${1:opt};}",
      "}"
    ],
    "description": "Smallest element > x as optional<T> (or nullopt if none) in O(log n)."
  },
  "OrderedTree: Sorted Vector Export": {
    "prefix": [
      "cp-ost-to-vector"
    ],
    "body": [
      "vector<${1:int}> ${2:v} = ${3:s}.to_vector();  // 0-indexed vector of all elements in sorted order"
    ],
    "description": "Export all elements of OrderedTree to a std::vector in sorted order in O(n)."
  }
